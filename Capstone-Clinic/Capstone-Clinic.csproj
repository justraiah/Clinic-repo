    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.28" />
    <PackageReference Include="NuGet.Frameworks" Version="7.6.0" />
    <PackageReference Include="QuestPDF" Version="2025.7.2" />
