

<!DOCTYPE html>
<html lang="en">
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Capstone_Clinic</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Capstone_Clinic.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light bg-white border-bottom shadow-sm sticky-top">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index">
                    🏥 Clinic Monitoring System
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Index" ? "active fw-bold text-primary" : "")"
                                   asp-page="/Index">
                                    🏠 Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Student/Search" ? "active fw-bold text-primary" : "")"
                                   asp-page="/Student/Search">
                                    👤 Student Lookup
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/MedicalRecordPages/Index" ? "active fw-bold text-primary" : "")"
                                   asp-page="/MedicalRecordPages/Index">
                                    📄 Medical Records
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentPage!.StartsWith("/VitalSignLogPages") ? "active fw-bold text-primary" : "")"
                                   asp-page="/VitalSignLogPages/Index">
                                    ❤️ Vital Signs
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(currentPage!.StartsWith("/AlertPages") ? "active fw-bold text-primary" : "")"
                                   asp-page="/AlertPages/Index">
                                    🚨 Alerts
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage!.StartsWith("/Reports") ? "active fw-bold text-primary" : "")"
                                   asp-page="/Reports/Index">
                                    📊 Reports
                                </a>
                            </li>

                            <li class="nav-item ms-auto">
                                <span class="nav-link text-secondary">
                                    👤 @User.Identity?.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link text-danger"
                                   asp-page="/Logout">
                                    🚪 Logout
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-auto">
                                <a class="nav-link text-primary"
                                   asp-page="/Login">
                                    🔐 Login
                                </a>
                            </li>
                        }

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 Clinic Monitoring System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>