@page "{id:int}"
@model Capstone_Clinic.Pages.DentalRecordPages.DeleteModel

@{
    ViewData["Title"] = "Delete Dental Record";
}

<div class="container mt-4">
    <div class="mb-4">
        <h1>Delete Dental Record</h1>
        <p class="text-muted">Review the record before confirming deletion.</p>
    </div>

    @if (Model.DentalRecord is not null)
    {
        <div class="card shadow-sm border-danger">
            <div class="card-body">
                <div class="alert alert-warning">
                    Are you sure you want to permanently delete this dental record?
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Patient</dt>
                    <dd class="col-sm-9">
                        @(Model.DentalRecord.ClinicPatient?.FullName ?? "Unknown Patient")
                    </dd>

                    <dt class="col-sm-3">Visit Date</dt>
                    <dd class="col-sm-9">
                        @Model.DentalRecord.VisitDate.ToString("MMMM dd, yyyy")
                    </dd>

                    <dt class="col-sm-3">Chief Complaint</dt>
                    <dd class="col-sm-9">@Model.DentalRecord.ChiefComplaint</dd>

                    <dt class="col-sm-3">Diagnosis</dt>
                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Model.DentalRecord.Diagnosis)
                            ? "—"
                            : Model.DentalRecord.Diagnosis)
                    </dd>
                </dl>

                <form method="post"
                      onsubmit="return confirm('Are you sure you want to permanently delete this dental record? This action cannot be undone.');">

                    <input type="hidden" asp-for="DentalRecord.DentalRecordId" />

                    <div class="form-check mb-3">
                        <input class="form-check-input"
                               type="checkbox"
                               id="confirmDelete"
                               name="ConfirmDelete"
                               value="true"
                               required />

                        <label class="form-check-label" for="confirmDelete">
                            I understand that this dental record will be permanently deleted.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-danger">
                        Confirm Delete
                    </button>


                    <a asp-page="./Index" class="btn btn-secondary ms-2">
                        Cancel
                    </a>
                </form>
            </div>
        </div>
    }
</div>
