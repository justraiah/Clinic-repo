@page
@model Capstone_Clinic.Pages.DentalRecordPages.IndexModel

@{
    ViewData["Title"] = "Dental Records";
}

<style>
    .records-header {
        margin-bottom: 24px;
    }

    .records-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1f2933;
        margin-bottom: 5px;
    }

    .records-subtitle {
        color: #64748b;
        font-size: .9rem;
        margin: 0;
        max-width: 850px;
    }

    .records-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .records-panel-header {
        padding: 17px 20px;
        border-bottom: 1px solid #e2e6eb;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .records-panel-title {
        margin: 0;
        font-size: .95rem;
        font-weight: 600;
        color: #1f2933;
    }

    .records-panel-description {
        margin: 3px 0 0;
        font-size: .76rem;
        color: #94a3b8;
    }

    .records-count {
        padding: 4px 8px;
        border-radius: 4px;
        background: #f1f5f9;
        color: #64748b;
        font-size: .68rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .records-table {
        margin: 0;
    }

        .records-table thead th {
            background: #f8fafc;
            color: #64748b;
            font-size: .7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .03em;
            padding: 12px 16px;
            border-bottom: 1px solid #e2e6eb;
            white-space: nowrap;
        }

        .records-table tbody td {
            padding: 14px 16px;
            color: #475569;
            font-size: .8rem;
            border-bottom: 1px solid #eef0f2;
            vertical-align: middle;
        }

        .records-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .records-table tbody tr:hover {
            background: #f8fafc;
        }

    .empty-records {
        padding: 55px 20px;
        text-align: center;
    }

    .empty-records-title {
        color: #334155;
        font-size: .95rem;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .empty-records-text {
        color: #94a3b8;
        font-size: .8rem;
        margin-bottom: 16px;
    }

    @@media (max-width: 767.98px) {
        .records-panel-header {
            display: block;
        }

        .records-count {
            display: inline-block;
            margin-top: 10px;
        }
    }
</style>

<div class="records-header">
    <h1 class="records-title">Dental Records</h1>

    <p class="records-subtitle">
        View and manage patient dental consultations, findings, diagnoses,
        treatments, and dental care history.
    </p>
</div>

<div class="records-panel">

    <div class="records-panel-header">
        <div>
            <h2 class="records-panel-title">Patient Dental Records</h2>
            <p class="records-panel-description">
                Dental consultations registered in the clinic system.
            </p>
        </div>

        <div style="display: flex; align-items: center; gap: 12px;">
            <span class="records-count">
                @Model.DentalRecordCount @(Model.DentalRecordCount == 1 ? "record" : "records")
            </span>
            <a asp-page="./Create" class="btn btn-primary">
                + New Dental Record
            </a>
        </div>
    </div>

    
    @if (Model.DentalRecords.Any())
    {
        <div class="table-responsive">
            <table class="records-table">
                <thead>
                    <tr>
                        <th>Patient</th>
                        <th>Visit Date</th>
                        <th>Chief Complaint</th>
                        <th>Diagnosis</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.DentalRecords)
                    {
                        <tr>
                            <td>
                                @(item.ClinicPatient?.Student?.FullName
                                    ?? item.ClinicPatient?.FullName
                                    ?? "Unknown Patient")
                            </td>
                            <td>@item.VisitDate.ToString("MMM dd, yyyy")</td>
                            <td>@item.ChiefComplaint</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(item.Diagnosis)
                                    ? "—"
                                    : item.Diagnosis)
                            </td>
                            
                            <td>
                                <a asp-page="./Details"
                                   asp-route-id="@item.DentalRecordId"
                                   class="btn btn-sm btn-outline-primary">
                                    View
                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@item.DentalRecordId"
                                   class="btn btn-sm btn-outline-secondary">
                                    Edit
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@item.DentalRecordId"
                                   class="btn btn-sm btn-outline-danger">
                                    Delete
                                </a>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }
    else
    {
        <div class="empty-records">
            <div class="empty-records-title">No dental records yet</div>
            <div class="empty-records-text">
                Dental consultations will appear here once they have been recorded.
            </div>
        </div>
    }

</div>
