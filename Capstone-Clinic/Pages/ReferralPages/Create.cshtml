
@page
@model Capstone_Clinic.Pages.ReferralPages.CreateModel

@{
    ViewData["Title"] = "New Referral";
}

<div class="container-fluid">
    <div class="mb-4">
        <h1 class="h3 mb-1">New Referral</h1>
        <p class="text-muted mb-0">
            Refer a student or community patient to an outside healthcare facility.
        </p>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Referral.ClinicPatientId"
                               class="form-label">Patient</label>

                        <select asp-for="Referral.ClinicPatientId"
                                asp-items="Model.PatientOptions"
                                class="form-select">
                            <option value="">-- Select Patient --</option>
                        </select>

                        <span asp-validation-for="Referral.ClinicPatientId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Referral.ReferralDate"
                               class="form-label">Referral Date</label>

                        <input asp-for="Referral.ReferralDate"
                               type="date"
                               class="form-control"
                               asp-format="{0:yyyy-MM-dd}" />

                        <span asp-validation-for="Referral.ReferralDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Referral.FacilityName"
                               class="form-label">Hospital / Healthcare Facility</label>

                        <input asp-for="Referral.FacilityName"
                               class="form-control"
                               placeholder="Enter destination facility name" />

                        <span asp-validation-for="Referral.FacilityName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Referral.ReasonForReferral"
                               class="form-label">Reason for Referral</label>

                        <textarea asp-for="Referral.ReasonForReferral"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Describe why the patient needs referral"></textarea>

                        <span asp-validation-for="Referral.ReasonForReferral"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Referral.ClinicalNotes"
                               class="form-label">Clinical Notes (Optional)</label>

                        <textarea asp-for="Referral.ClinicalNotes"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Relevant findings or additional information"></textarea>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex gap-2 justify-content-end">
                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">Cancel</a>

                    <button type="submit" class="btn btn-primary">
                        Save Referral
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
