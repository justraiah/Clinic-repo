@page
@model Capstone_Clinic.Pages.Student.SearchModel
@{
    ViewData["Title"] = "Student Lookup";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">🔍 Student Lookup</h4>
        </div>

        <div class="card-body">

            <p class="text-muted">
                <p class="text-muted">
                    Search a student using their Student Number or full name.
                </p>
            </p>

            <form method="post">

                <div class="row">

                    <div class="col-md-9">
                        <input asp-for="SearchStudentNumber"
                               class="form-control"
                               placeholder="Enter Student Number (e.g. 26-00001)" />
                        <span asp-validation-for="SearchStudentNumber"
                              class="text-danger small">
                        </span>
                    </div>

                    <div class="col-md-3">
                        <button class="btn btn-primary w-100">
                            Search
                        </button>
                    </div>

                </div>

            </form>

            <hr />

            @if (Model.Student != null)
            {
                <div class="d-flex justify-content-between align-items-center mb-3">

                    <h5 class="text-success mb-0">
                        Student Information
                    </h5>

                    <a asp-page="/StudentPages/Edit"
                       asp-route-id="@Model.Student.StudentId"
                       class="btn btn-sm btn-outline-primary">
                        ✏️ Edit Student
                    </a>

                </div>

                <table class="table table-bordered">

                    <tr>
                        <th width="220">Student Number</th>
                        <td>@Model.Student.StudentNumber</td>
                    </tr>

                    <tr>
                        <th>Full Name</th>
                        <td>@Model.Student.FullName</td>
                    </tr>

                    <tr>
                        <th>Course</th>
                        <td>@Model.Student.Course</td>
                    </tr>

                    <tr>
                        <th>Year Level</th>
                        <td>@Model.Student.YearLevel</td>
                    </tr>
                    <tr>
                        <th>Medical Requirements</th>

                        <td>

                            @if (Model.Student.MedicalRequirementStatus == "Complete")
                            {
                                <span class="badge bg-success">
                                    🟢 Complete
                                </span>
                            }
                            else if (Model.Student.MedicalRequirementStatus == "Pending Review")
                            {
                                <span class="badge bg-warning text-dark">
                                    🟡 Pending Review
                                </span>
                            }
                            else if (Model.Student.MedicalRequirementStatus == "Incomplete")
                            {
                                <span class="badge bg-danger">
                                    🟠 Incomplete
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    ⚪ Not Submitted
                                </span>
                            }

                            <div class="form-text">
                                This status does not restrict clinic services.
                            </div>

                        </td>
                    </tr>

                </table>

                <div class="mt-4">

                    <h5 class="mt-4 text-primary">
                        📋 Clinic Actions
                    </h5>

                    <div class="d-grid gap-2">

                        @if (Model.HasMedicalRecord)
                        {
                            <a class="btn btn-success"
                               asp-page="/MedicalRecordPages/Details"
                               asp-route-id="@Model.MedicalRecordId">
                                📄 Open Medical Record
                            </a>

                            <a class="btn btn-danger"
                               asp-page="/VitalSignLogPages/Create"
                               asp-route-medicalRecordId="@Model.MedicalRecordId">
                                ❤️ Record Vital Signs
                            </a>

                            <a class="btn btn-info text-white"
                               asp-page="/VitalSignLogPages/Index"
                               asp-route-medicalRecordId="@Model.MedicalRecordId">
                                📈 View Vital History
                            </a>
                        }
                        else
                        {
                            <a class="btn btn-primary"
                               asp-page="/MedicalRecordPages/Create"
                               asp-route-studentId="@Model.Student.StudentId">
                                🩺 Start Consultation
                            </a>
                        }

                    </div>

                </div>
            }

            @if (Model.StudentNotFound)
            {
                <div class="alert alert-warning mt-3">

                    <h5 class="mb-2">
                        ⚠️ Student Not Found
                    </h5>

                    <p class="mb-3">
                        No student was found using that Student Number.
                        You can register the student and continue with clinic care.
                    </p>

                    <a asp-page="/StudentPages/Create"
                       class="btn btn-primary">
                        ➕ Add New Student
                    </a>

                </div>
            }

        </div>

    </div>

</div>