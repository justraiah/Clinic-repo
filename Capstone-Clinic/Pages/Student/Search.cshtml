@page
@model Capstone_Clinic.Pages.Student.SearchModel

@{
    ViewData["Title"] = "Patient Lookup";
}

<style>
    .lookup-header {
        margin-bottom: 24px;
    }

    .lookup-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1e3a5f;
        margin-bottom: 5px;
        position: relative;
        padding-left: 14px;
    }

    .lookup-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4px;
        bottom: 4px;
        width: 4px;
        border-radius: 3px;
        background: #2563eb;
    }

    .lookup-subtitle {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .lookup-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 18px;
    }

    .lookup-panel-header {
        padding: 16px 20px;
        background: #fbfcfe;
        border-bottom: 1px solid #e2e6eb;
        border-left: 3px solid #2563eb;
    }

    .lookup-panel-title {
        margin: 0;
        font-size: .95rem;
        font-weight: 600;
        color: #1f2933;
    }

    .lookup-panel-description {
        margin: 3px 0 0;
        font-size: .74rem;
        color: #94a3b8;
    }

    .lookup-panel-body {
        padding: 20px;
    }

    .search-label {
        display: block;
        font-size: .75rem;
        font-weight: 600;
        color: #475569;
        margin-bottom: 6px;
    }

    .search-input {
        height: 42px;
        border-color: #d9dee5;
        font-size: .85rem;
    }

    .search-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .15rem rgba(37, 99, 235, .10);
    }

    .search-button {
        height: 42px;
        padding: 0 24px;
        font-size: .78rem;
    }

    .student-result {
        margin-top: 24px;
        border-top: 1px solid #e2e6eb;
        padding-top: 24px;
    }

    .student-result-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 18px;
    }

    .student-result-title {
        margin: 0;
        font-size: .95rem;
        font-weight: 600;
        color: #1f2933;
    }

    .student-result-subtitle {
        margin: 4px 0 0;
        font-size: .74rem;
        color: #94a3b8;
    }

    .student-info-table {
        margin: 0;
        border: 1px solid #e2e6eb;
    }

    .student-info-table th {
        width: 190px;
        background: #f8fafc;
        color: #64748b;
        font-size: .74rem;
        font-weight: 600;
        padding: 12px 14px;
        border-color: #e2e6eb;
    }

    .student-info-table td {
        color: #334155;
        font-size: .8rem;
        padding: 12px 14px;
        border-color: #e2e6eb;
    }

    .requirement-status {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: .68rem;
        font-weight: 600;
    }

    .requirement-complete {
        color: #166534;
        background: #dcfce7;
    }

    .requirement-pending {
        color: #92400e;
        background: #fef3c7;
    }

    .requirement-incomplete {
        color: #991b1b;
        background: #fee2e2;
    }

    .requirement-none {
        color: #475569;
        background: #f1f5f9;
    }

    .requirement-note {
        margin-top: 5px;
        font-size: .7rem;
        color: #94a3b8;
    }

    .clinic-actions {
        margin-top: 24px;
    }

    .clinic-actions-title {
        margin-bottom: 12px;
        font-size: .85rem;
        font-weight: 600;
        color: #334155;
    }

    .clinic-action-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .clinic-action {
        min-height: 76px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        padding: 12px 14px;
        text-decoration: none;
        border: 1px solid #d9dee5;
        border-radius: 7px;
        background: #ffffff;
        transition: background .15s ease, border-color .15s ease, box-shadow .15s ease;
    }

    .clinic-action:hover {
        background: #f8fafc;
        border-color: #93c5fd;
        box-shadow: 0 1px 3px rgba(15, 23, 42, .05);
    }

    .clinic-action-title {
    display: inline-block;
    padding: 6px 10px;
    border-radius: 5px;
    background: #1e3a5f;
    color: #ffffff;
    font-size: .78rem;
    font-weight: 600;
    line-height: 1.2;
    transition: background .15s ease;
}

.clinic-action:hover .clinic-action-title {
    background: #2563eb;
}

    .clinic-action-description {
        margin-top: 3px;
        font-size: .68rem;
        color: #94a3b8;
    }

    .not-found {
        margin-top: 24px;
        padding: 18px;
        border: 1px solid #fde68a;
        border-left: 3px solid #d97706;
        border-radius: 7px;
        background: #fffbeb;
    }

    .not-found-title {
        font-size: .85rem;
        font-weight: 600;
        color: #92400e;
        margin-bottom: 4px;
    }

    .not-found-text {
        font-size: .76rem;
        color: #78350f;
        margin-bottom: 14px;
    }

    .success-message {
        margin-bottom: 20px;
    }

    @@media (max-width: 767.98px) {

        .student-result-header {
            display: block;
        }

        .student-result-header .btn {
            margin-top: 12px;
        }

        .clinic-action-grid {
            grid-template-columns: 1fr;
        }

        .search-button {
            width: 100%;
        }
    }
</style>


<!-- Page Header -->

<div class="lookup-header">

    <h1 class="lookup-title">
    Patient Lookup
    </h1>

    <p class="lookup-subtitle">
        Find a patient and access their clinic records.
    </p>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show success-message"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<!-- Search Panel -->

<div class="lookup-panel">

    <div class="lookup-panel-header">

        <h2 class="lookup-panel-title">
            Find Patient
        </h2>

        <p class="lookup-panel-description">
            Search using a name, Student Number, or patient identifier.
        </p>

    </div>


    <div class="lookup-panel-body">

        <form method="post">

            <div class="row g-2 align-items-end">

                <div class="col-md-9">

                    <label class="search-label">
                        Name, Student Number, or Identifier
                    </label>

                    <input asp-for="SearchStudentNumber"
                           class="form-control search-input"
                           placeholder="Example: 23-00148 or Juan Dela Cruz" />

                    <span asp-validation-for="SearchStudentNumber"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-3">

                    <button type="submit"
                            class="btn btn-primary search-button w-100">
                        Search Patient
                    </button>

                </div>

            </div>

        </form>

        @if (Model.PatientResults.Any(p => p.PatientType != "Student"))
        {
            <div class="student-result">

                <div class="student-result-header">
                    <div>
                        <h2 class="student-result-title">
                            Patient Information
                        </h2>

                        <p class="student-result-subtitle">
                            Patient information registered in the system.
                        </p>
                    </div>
                </div>

                @foreach (var patient in Model.PatientResults.Where(p => p.PatientType != "Student"))
                {
                    <div class="table-responsive mb-4">

                        <table class="table student-info-table">
                            <tbody>
                                <tr>
                                    <th>Patient Type</th>
                                    <td>@patient.PatientType</td>
                                </tr>

                                <tr>
                                    <th>Full Name</th>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(patient.FullName)
                                            ? "—"
                                            : patient.FullName)
                                    </td>
                                </tr>

                                <tr>
                                    <th>Identifier</th>
                                    <td>
                                        @(string.IsNullOrWhiteSpace(patient.Identifier)
                                            ? "—"
                                            : patient.Identifier)
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="clinic-actions">
                            <div class="clinic-actions-title">
                                Clinic Actions
                            </div>
                            <div class="clinic-actions">
                                <div class="clinic-actions-title">
                                    Dental History
                                </div>

                                @if (patient.ClinicPatientId.HasValue &&
                                     Model.DentalHistory.TryGetValue(
                                         patient.ClinicPatientId.Value,
                                         out var dentalRecords) &&
                                     dentalRecords.Any())
                                {
                                    <div class="table-responsive">
                                        <table class="table student-info-table">
                                            <thead>
                                                <tr>
                                                    <th>Visit Date</th>
                                                    <th>Chief Complaint</th>
                                                    <th>Diagnosis</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var dentalRecord in dentalRecords)
                                                {
                                                    <tr>
                                                        <td>
                                                            @dentalRecord.VisitDate.ToString("MMM dd, yyyy")
                                                        </td>
                                                        <td>@dentalRecord.ChiefComplaint</td>
                                                        <td>
                                                            @(string.IsNullOrWhiteSpace(dentalRecord.Diagnosis)
                                                                ? "—"
                                                                : dentalRecord.Diagnosis)
                                                        </td>
                                                        <td>
                                                            <a asp-page="/DentalRecordPages/Details"
                                                               asp-route-id="@dentalRecord.DentalRecordId"
                                                               class="btn btn-sm btn-outline-primary">
                                                                View
                                                            </a>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="requirement-note">
                                        No dental records have been recorded for this patient.
                                    </div>
                                }
                            </div>

                            @if (patient.MedicalRecordId.HasValue)
                            {
                                <a class="clinic-action"
                                   asp-page="/MedicalRecordPages/Details"
                                   asp-route-id="@patient.MedicalRecordId.Value">

                                    <span class="clinic-action-title">
                                        Open Medical Record
                                    </span>

                                    <span class="clinic-action-description">
                                        View consultation history
                                    </span>
                                </a>
                            }
                            else
                            {
                                <div class="requirement-note">
                                    No medical record is linked to this patient yet.
                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        }

        @if (Model.Student != null)
        {
            <div class="student-result">

                <div class="student-result-header">

                    <div>

                        <h2 class="student-result-title">
                            Student Information
                        </h2>

                        <p class="student-result-subtitle">
                            Patient information registered in the system.
                        </p>

                    </div>


                    <a asp-page="/StudentPages/Edit"
                       asp-route-id="@Model.Student.StudentId"
                       class="btn btn-sm btn-outline-primary">
                        Edit Student
                    </a>

                </div>


                <div class="table-responsive">

                    <table class="table student-info-table">

                        <tbody>

                            <tr>

                                <th>
                                    Student Number
                                </th>

                                <td>
                                    @Model.Student.StudentNumber
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Full Name
                                </th>

                                <td>
                                    @Model.Student.FullName
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Course
                                </th>

                                <td>
                                    @Model.Student.Course
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Year Level
                                </th>

                                <td>
                                    @Model.Student.YearLevel
                                </td>

                            </tr>


                            <tr>

                                <th>
                                    Medical Requirements
                                </th>

                               <td>
    @if (Model.MedicalRequirements.Any())
    {
        <table class="table table-sm align-middle mb-0">
            <thead>
                <tr>
                    <th>Requirement</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var requirement in Model.MedicalRequirements)
                {
                    <tr>
                        <td>@requirement.RequirementName</td>
                        <td>
    <form method="post"
          asp-page-handler="UpdateRequirement"
          class="d-inline">

        <input type="hidden"
               name="medicalRequirementId"
               value="@requirement.MedicalRequirementId" />

        @if (requirement.Status == "Complete")
        {
            <input type="hidden"
                   name="status"
                   value="Not Submitted" />

            <button type="submit"
                    class="requirement-status requirement-complete border-0">
                Complete
            </button>
        }
        else
        {
            <input type="hidden"
                   name="status"
                   value="Complete" />

            <button type="submit"
                    class="requirement-status requirement-none border-0">
                Not Submitted
            </button>
        }
    </form>
</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="requirement-note">
            No medical requirements have been recorded.
        </div>
    }
</td>

                            </tr>

                        </tbody>

                    </table>

                </div>

                <!-- Dental History -->

                <div class="clinic-actions">
                    <div class="clinic-actions-title">
                        Dental History
                    </div>

                    @if (Model.Student != null &&
                         Model.StudentClinicPatientIds.TryGetValue(
                             Model.Student.StudentId,
                             out var studentClinicPatientId) &&
                         Model.DentalHistory.TryGetValue(
                             studentClinicPatientId,
                             out var studentDentalRecords) &&
                         studentDentalRecords.Any())
                    {
                        <div class="table-responsive">
                            <table class="table student-info-table">
                                <thead>
                                    <tr>
                                        <th>Visit Date</th>
                                        <th>Chief Complaint</th>
                                        <th>Diagnosis</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var dentalRecord in studentDentalRecords)
                                    {
                                        <tr>
                                            <td>
                                                @dentalRecord.VisitDate.ToString("MMM dd, yyyy")
                                            </td>
                                            <td>@dentalRecord.ChiefComplaint</td>
                                            <td>
                                                @(string.IsNullOrWhiteSpace(dentalRecord.Diagnosis)
                                                    ? "—"
                                                    : dentalRecord.Diagnosis)
                                            </td>
                                            <td>
                                                <a asp-page="/DentalRecordPages/Details"
                                                   asp-route-id="@dentalRecord.DentalRecordId"
                                                   class="btn btn-sm btn-outline-primary">
                                                    View
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="requirement-note">
                            No dental records have been recorded for this student.
                        </div>
                    }
                </div>

                <!-- Clinic Actions -->

                <div class="clinic-actions">

                    <div class="clinic-actions-title">
                        Clinic Actions
                    </div>


                    @if (Model.HasMedicalRecord)
                    {
                        <div class="clinic-action-grid">

                            <a class="clinic-action"
                               asp-page="/MedicalRecordPages/Details"
                               asp-route-id="@Model.MedicalRecordId">

                                <span class="clinic-action-title">
                                    Open Medical Record
                                </span>

                                <span class="clinic-action-description">
                                    View consultation history
                                </span>

                            </a>


                            <a class="clinic-action"
                               asp-page="/VitalSignLogPages/Create"
                               asp-route-medicalRecordId="@Model.MedicalRecordId">

                                <span class="clinic-action-title">
                                    Record Vital Signs
                                </span>

                                <span class="clinic-action-description">
                                    Add a new measurement
                                </span>

                            </a>


                            <a class="clinic-action"
                               asp-page="/VitalSignLogPages/Index"
                               asp-route-medicalRecordId="@Model.MedicalRecordId">

                                <span class="clinic-action-title">
                                    View Vital History
                                </span>

                                <span class="clinic-action-description">
                                    Review previous readings
                                </span>

                            </a>

                        </div>
                    }
                    else
                    {
                        <a class="clinic-action"
                           asp-page="/MedicalRecordPages/Create"
                           asp-route-studentId="@Model.Student.StudentId">

                            <span class="clinic-action-title">
                                Start Consultation
                            </span>

                            <span class="clinic-action-description">
                                Create the student's first clinic record
                            </span>

                        </a>
                    }

                </div>

            </div>
        }


        @if (Model.StudentNotFound)
        {
            <div class="not-found">

                <div class="not-found-title">
                    Patient Not Found
                </div>

                <div class="not-found-text">
                    No patient was found using that Patient ID or name.
                    You can register the patient and continue with clinic care.
                </div>

                <a asp-page="/StudentPages/Create"
                   class="btn btn-sm btn-outline-warning">
                    Add New Patient
                </a>

            </div>
        }

    </div>

</div>