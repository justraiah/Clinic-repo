@page
@model Capstone_Clinic.Pages.Reports.TrendAnalysis.IndexModel

@{
    ViewData["Title"] = "Trend Analysis Reports";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <a asp-page="/Reports/Index"
               class="btn btn-outline-secondary btn-sm mb-3">

                <i class="bi bi-arrow-left me-2"></i>
                Back to Reports

            </a>

            <h2 class="fw-bold mb-0">
                Trend Analysis Reports
            </h2>

            <small class="text-muted">
                Comprehensive overview of clinic consultations, alerts, and patient health trends.
            </small>

        </div>

        <a asp-page-handler="ExportPdf"
           class="btn btn-primary">

            <i class="bi bi-file-earmark-arrow-down me-2"></i>
            Export PDF

        </a>

    </div>

    <div class="row g-3 mb-4">

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-primary">
                <div class="card-body">
                    <small class="text-muted">
                        <i class="bi bi-file-earmark-medical text-primary me-1"></i>
                        Total Consultations
                    </small>
                    <h2 class="fw-bold display-6 text-primary mt-2">
                        @Model.TotalConsultations
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                <div class="card-body">

                    <small class="text-muted">
                        <i class="bi bi-people-fill text-success me-1"></i>
                        Patients Served
                    </small>

                    <h2 class="fw-bold display-6 text-success mt-2">
                        @Model.PatientsServed
                    </h2>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-danger h-100">
                <div class="card-body">

                    <small class="text-muted">
                        <i class="bi bi-exclamation-triangle-fill text-danger me-1"></i>
                        Health Alerts
                    </small>

                    <h2 class="fw-bold display-6 text-danger mt-2">
                        @Model.HealthAlerts
                    </h2>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                <div class="card-body">

                    <small class="text-muted">
                        <i class="bi bi-heart-pulse-fill text-info me-1"></i>
                        Average Heart Rate
                    </small>

                    <h2 class="fw-bold display-6 text-info mt-2">
                        @Model.AverageHeartRate.ToString("F1") BPM
                    </h2>

                </div>
            </div>
        </div>

    </div>

    <div class="row g-4">

        <!-- Main Chart -->
        <div class="col-12">

            <div class="card shadow-sm border-0">

                <div class="card-header fw-semibold">
                    Monthly Consultation Trend
                </div>

                <div class="card-body">

                    <canvas id="consultationChart" height="110"></canvas>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header fw-semibold">
                    Alert Distribution
                </div>

                <div class="card-body d-flex justify-content-center align-items-center">

                    <div style="width:250px; height:250px;">
                        <canvas id="alertChart"></canvas>
                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-header fw-semibold">
                    Top Visit Reasons
                </div>

                <div class="card-body">

                    <canvas id="visitReasonChart" height="220"></canvas>

                </div>

            </div>

        </div>

        <!-- Insights -->
        <div class="col-12">

            <div class="card shadow-sm border-0">

                <div class="card-header fw-semibold">
                    Insights
                </div>

                <div class="card-body">

                    <ul class="mb-0">

                        @foreach (var item in Model.Insights)
                        {
                            <li>@item</li>
                        }

                    </ul>

                </div>

            </div>

        </div>

    </div>
    

</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthLabels));
        const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthConsultationCounts));
    </script>
    <script>

        const ctx = document.getElementById('consultationChart');

        new Chart(ctx, {

            type: 'line',

            data: {

                labels: labels,

                datasets: [{

                    label: 'Consultations',

                    data: values,

                    borderWidth: 3,

                    tension: .35,

                    fill: true,

                    backgroundColor: 'rgba(13,110,253,.12)',

                    borderColor: '#0d6efd',

                    pointRadius: 5,

                    pointHoverRadius: 7

                }]

            },

            options: {

                responsive: true,

                maintainAspectRatio: false,

                plugins: {

                    legend: {

                        display: false

                    }

                },

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {

                            precision: 0

                        }

                    }

                }

            }

        });

    </script>
    <script>

        const alertCtx = document.getElementById('alertChart');

        new Chart(alertCtx, {

            type: 'doughnut',

            data: {

                labels: [

                    'Active',
                    'Acknowledged',
                    'Resolved'

                ],

                datasets: [{

                    data: [

                        @Model.ActiveAlerts,
                        @Model.AcknowledgedAlerts,
                        @Model.ResolvedAlerts

                    ],

                    backgroundColor: [

                        '#dc3545',
                        '#ffc107',
                        '#198754'

                    ],

                    borderWidth: 1

                }]

            },

            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '50%',
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }

        });

    </script>
    <script>

        const visitReasonCtx = document.getElementById('visitReasonChart');

        new Chart(visitReasonCtx, {

            type: 'bar',

            data: {

                labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VisitReasonLabels)),

                datasets: [{

                    label: 'Number of Visits',

                    data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VisitReasonCounts)),

                    backgroundColor: '#0d6efd',

                    borderRadius: 8,

                    borderSkipped: false

                }]

            },

            options: {

                responsive: true,

                plugins: {

                    legend: {

                        display: false

                    }

                },

                scales: {

                    y: {

                        beginAtZero: true,

                        ticks: {

                            precision: 0

                        }

                    }

                }

            }

        });

    </script>
}