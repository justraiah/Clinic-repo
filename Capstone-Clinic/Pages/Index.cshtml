@page
@model IndexModel

@functions {

    string GetRelativeTime(DateTime date)
    {
        var span = DateTime.Now - date;

        if (span.TotalMinutes < 1)
            return "Just now";

        if (span.TotalMinutes < 60)
            return $"{(int)span.TotalMinutes} min ago";

        if (span.TotalHours < 24)
            return $"{(int)span.TotalHours} hr ago";

        return $"{(int)span.TotalDays} day(s) ago";
    }

}

@{
    ViewData["Title"] = "Clinic Dashboard";
}

<style>
    .dashboard-header {
        margin-bottom: 28px;
    }

    .dashboard-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1f2933;
        margin-bottom: 5px;
    }

    .dashboard-subtitle {
        color: #64748b;
        font-size: .9rem;
        margin: 0;
    }

    .dashboard-stat {
        height: 100%;
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        padding: 20px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

    .dashboard-stat:hover {
        border-color: #cbd5e1;
        box-shadow: 0 4px 12px rgba(15, 23, 42, .06);
    }

    .dashboard-stat-label {
        color: #64748b;
        font-size: .8rem;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .dashboard-stat-value {
        color: #1f2933;
        font-size: 1.8rem;
        font-weight: 600;
        line-height: 1;
    }

    .dashboard-stat-description {
        color: #94a3b8;
        font-size: .75rem;
        margin-top: 8px;
    }

    .dashboard-stat-accent {
        width: 3px;
        height: 42px;
        border-radius: 3px;
        background: #2563eb;
        flex-shrink: 0;
    }

    .dashboard-stat-accent.neutral {
        background: #64748b;
    }

    .dashboard-stat-accent.success {
        background: #16a34a;
    }

    .dashboard-stat-accent.danger {
        background: #dc2626;
    }

    .dashboard-section {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
    }

    .dashboard-section-header {
        padding: 17px 20px;
        border-bottom: 1px solid #e2e6eb;
    }

    .dashboard-section-title {
        margin: 0;
        font-size: .95rem;
        font-weight: 600;
        color: #1f2933;
    }

    .dashboard-section-subtitle {
        margin: 3px 0 0;
        font-size: .76rem;
        color: #94a3b8;
    }

    .dashboard-section-body {
        padding: 20px;
    }

    .dashboard-alert {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 15px 16px;
        border: 1px solid #fecaca;
        border-left: 4px solid #dc2626;
        border-radius: 6px;
        background: #fffafa;
    }

    .dashboard-alert-title {
        font-size: .88rem;
        font-weight: 600;
        color: #7f1d1d;
    }

    .dashboard-alert-text {
        font-size: .78rem;
        color: #64748b;
        margin-top: 3px;
    }

    .dashboard-alert-count {
        font-size: 1.5rem;
        font-weight: 600;
        color: #dc2626;
        white-space: nowrap;
    }

    .dashboard-status {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px 0;
        border-bottom: 1px solid #eef0f2;
    }

    .dashboard-status:last-child {
        border-bottom: 0;
        padding-bottom: 0;
    }

    .dashboard-status:first-child {
        padding-top: 0;
    }

    .status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #16a34a;
        flex-shrink: 0;
    }

    .dashboard-status-name {
        font-size: .82rem;
        color: #475569;
        flex: 1;
    }

    .dashboard-status-value {
        font-size: .8rem;
        font-weight: 500;
        color: #16a34a;
    }

    .dashboard-table {
        margin: 0;
    }

    .dashboard-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: .72rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        border-bottom: 1px solid #e2e6eb;
        padding: 11px 14px;
    }

    .dashboard-table tbody td {
        color: #475569;
        font-size: .82rem;
        padding: 13px 14px;
        border-bottom: 1px solid #eef0f2;
        vertical-align: middle;
    }

    .dashboard-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .dashboard-patient-name {
        font-weight: 500;
        color: #1f2933;
    }

    .dashboard-patient-id {
        display: block;
        margin-top: 2px;
        font-size: .7rem;
        color: #94a3b8;
    }

    .dashboard-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: .68rem;
        font-weight: 600;
    }

    .dashboard-badge-critical {
        color: #b91c1c;
        background: #fee2e2;
    }

    .dashboard-badge-warning {
        color: #92400e;
        background: #fef3c7;
    }

    .dashboard-badge-acknowledged {
        color: #166534;
        background: #dcfce7;
    }

    .dashboard-badge-default {
        color: #475569;
        background: #f1f5f9;
    }

    .dashboard-empty {
        padding: 35px 20px;
        text-align: center;
        color: #94a3b8;
        font-size: .82rem;
    }

    .dashboard-footer-note {
        margin-top: 18px;
        color: #94a3b8;
        font-size: .72rem;
    }
</style>

<!-- Dashboard Header -->
<div class="dashboard-header">

    <h1 class="dashboard-title">
        Clinic Dashboard
    </h1>

    <p class="dashboard-subtitle">
        Overview of patient records, vital signs, and clinic alerts.
    </p>

</div>


<!-- Statistics -->
<div class="row g-3 mb-4">

    <div class="col-xl-3 col-md-6">

        <a asp-page="/Student/Search"
           class="text-decoration-none">

            <div class="dashboard-stat">

                <div class="d-flex align-items-center gap-3">

                    <div class="dashboard-stat-accent">
                    </div>

                    <div>

                        <div class="dashboard-stat-label">
                            Students
                        </div>

                        <div class="dashboard-stat-value">
                            @Model.StudentCount
                        </div>

                        <div class="dashboard-stat-description">
                            Registered students
                        </div>

                    </div>

                </div>

            </div>

        </a>

    </div>


    <div class="col-xl-3 col-md-6">

        <a asp-page="/MedicalRecordPages/Index"
           class="text-decoration-none">

            <div class="dashboard-stat">

                <div class="d-flex align-items-center gap-3">

                    <div class="dashboard-stat-accent neutral">
                    </div>

                    <div>

                        <div class="dashboard-stat-label">
                            Medical Records
                        </div>

                        <div class="dashboard-stat-value">
                            @Model.MedicalRecordCount
                        </div>

                        <div class="dashboard-stat-description">
                            Patient records
                        </div>

                    </div>

                </div>

            </div>

        </a>

    </div>


    <div class="col-xl-3 col-md-6">

        <a asp-page="/VitalSignLogPages/Index"
           class="text-decoration-none">

            <div class="dashboard-stat">

                <div class="d-flex align-items-center gap-3">

                    <div class="dashboard-stat-accent success">
                    </div>

                    <div>

                        <div class="dashboard-stat-label">
                            Vital Signs
                        </div>

                        <div class="dashboard-stat-value">
                            @Model.VitalSignCount
                        </div>

                        <div class="dashboard-stat-description">
                            Measurements recorded
                        </div>

                    </div>

                </div>

            </div>

        </a>

    </div>


    <div class="col-xl-3 col-md-6">

        <a asp-page="/AlertPages/Index"
           class="text-decoration-none">

            <div class="dashboard-stat">

                <div class="d-flex align-items-center gap-3">

                    <div class="dashboard-stat-accent danger">
                    </div>

                    <div>

                        <div class="dashboard-stat-label">
                            Active Alerts
                        </div>

                        <div class="dashboard-stat-value">
                            @Model.ActiveAlertCount
                        </div>

                        <div class="dashboard-stat-description">
                            Require attention
                        </div>

                    </div>

                </div>

            </div>

        </a>

    </div>

</div>


<!-- Main Dashboard Content -->
<div class="row g-3">

    <!-- Alerts -->
    <div class="col-lg-7">

        <div class="dashboard-section h-100">

            <div class="dashboard-section-header">

                <h2 class="dashboard-section-title">
                    Active Alerts
                </h2>

                <p class="dashboard-section-subtitle">
                    Vital-sign alerts requiring staff attention.
                </p>

            </div>

            <div class="dashboard-section-body">

                @if (Model.ActiveAlertCount > 0)
                {
                    <div class="dashboard-alert">

                        <div>

                            <div class="dashboard-alert-title">
                                Active alert(s) require attention
                            </div>

                            <div class="dashboard-alert-text">
                                Review the Alerts page to view patient details,
                                severity, and acknowledgement status.
                            </div>

                        </div>

                        <div class="dashboard-alert-count">
                            @Model.ActiveAlertCount
                        </div>

                    </div>

                    <div class="mt-3">

                        <a asp-page="/AlertPages/Index"
                           class="btn btn-sm btn-outline-danger">
                            View Alerts
                        </a>

                    </div>
                }
                else
                {
                    <div class="dashboard-empty">

                        No active alerts at this time.

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- System Status -->
    <div class="col-lg-5">

        <div class="dashboard-section h-100">

            <div class="dashboard-section-header">

                <h2 class="dashboard-section-title">
                    System Status
                </h2>

                <p class="dashboard-section-subtitle">
                    Current system services.
                </p>

            </div>

            <div class="dashboard-section-body">

                <div class="dashboard-status">

                    <span class="status-dot"></span>

                    <span class="dashboard-status-name">
                        Database
                    </span>

                    <span class="dashboard-status-value">
                        @Model.DatabaseStatus
                    </span>

                </div>


                <div class="dashboard-status">

                    <span class="status-dot"></span>

                    <span class="dashboard-status-name">
                        Alert Engine
                    </span>

                    <span class="dashboard-status-value">
                        @Model.AlertEngineStatus
                    </span>

                </div>


                <div class="dashboard-status">

                    <span class="status-dot"></span>

                    <span class="dashboard-status-name">
                        Last Updated
                    </span>

                    <span class="dashboard-status-value">
                        @Model.LastUpdated.ToString("h:mm tt")
                    </span>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Recent Activity -->
<div class="dashboard-section mt-3">

    <div class="dashboard-section-header">

        <h2 class="dashboard-section-title">
            Recent Alerts
        </h2>

        <p class="dashboard-section-subtitle">
            Latest alert activity recorded by the clinic system.
        </p>

    </div>

    @if (Model.RecentActivities.Any())
    {
        <div class="table-responsive">

            <table class="table dashboard-table">

                <thead>

                    <tr>
                        <th>Patient</th>
                        <th>Alert</th>
                        <th>Status</th>
                        <th>Time</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.RecentActivities)
                    {
                        <tr>

                            <td>

                                <span class="dashboard-patient-name">
                                    @item.StudentName
                                </span>

                                @if (!string.IsNullOrWhiteSpace(item.StudentNumber))
                                {
                                    <span class="dashboard-patient-id">
                                        @item.StudentNumber
                                    </span>
                                }

                            </td>


                            <td>
                                @item.Activity
                            </td>


                            <td>

                                @if (item.Severity == "Active")
                                {
                                    <span class="dashboard-badge dashboard-badge-critical">
                                        Active
                                    </span>
                                }
                                else if (item.Severity == "Acknowledged")
                                {
                                    <span class="dashboard-badge dashboard-badge-acknowledged">
                                        Acknowledged
                                    </span>
                                }
                                else
                                {
                                    <span class="dashboard-badge dashboard-badge-default">
                                        @item.Severity
                                    </span>
                                }

                            </td>


                            <td>
                                @GetRelativeTime(item.Time)
                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="dashboard-empty">
            No recent alert activity.
        </div>
    }

</div>


<div class="dashboard-footer-note">
    Last dashboard update:
    @Model.LastUpdated.ToString("MMM dd, yyyy hh:mm:ss tt")
</div>