@page
@model Capstone_Clinic.Pages.StudentPages.EditModel

@{
    ViewData["Title"] = "Edit Student";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            ✏️ Edit Student
        </h2>

        <p class="text-muted mb-0">
            Update the student's information and medical requirements status.
        </p>
    </div>

    <a asp-page="./Index"
       class="btn btn-outline-secondary">
        ← Back to Students
    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-4">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden"
                   asp-for="Student.StudentId" />

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="Student.StudentNumber"
                           class="form-label">
                        Student Number
                    </label>

                    <input asp-for="Student.StudentNumber"
                           class="form-control" />

                    <span asp-validation-for="Student.StudentNumber"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Student.FullName"
                           class="form-label">
                        Full Name
                    </label>

                    <input asp-for="Student.FullName"
                           class="form-control" />

                    <span asp-validation-for="Student.FullName"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Student.Course"
                           class="form-label">
                        Course
                    </label>

                    <input asp-for="Student.Course"
                           class="form-control" />

                    <span asp-validation-for="Student.Course"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Student.YearLevel"
                           class="form-label">
                        Year Level
                    </label>

                    <input asp-for="Student.YearLevel"
                           class="form-control" />

                    <span asp-validation-for="Student.YearLevel"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="Student.MedicalRequirementStatus"
                           class="form-label">
                        Medical Requirements Status
                    </label>

                    <select asp-for="Student.MedicalRequirementStatus"
                            class="form-select">

                        <option value="Not Submitted">
                            ⚪ Not Submitted
                        </option>

                        <option value="Pending Review">
                            🟡 Pending Review
                        </option>

                        <option value="Incomplete">
                            🟠 Incomplete
                        </option>

                        <option value="Complete">
                            🟢 Complete
                        </option>

                    </select>

                    <div class="form-text">
                        This status does not restrict clinic services.
                    </div>

                    <span asp-validation-for="Student.MedicalRequirementStatus"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-page="./Index"
                   class="btn btn-outline-secondary ms-1">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}