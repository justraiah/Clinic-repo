@page
@model Capstone_Clinic.Pages.StudentPages.EditModel

@{
    ViewData["Title"] = "Edit Student";
}

<style>
    .student-header {
        margin-bottom: 24px;
    }

    .student-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1e3a5f;
        margin-bottom: 5px;
        position: relative;
        padding-left: 14px;
    }

    .student-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4px;
        bottom: 4px;
        width: 4px;
        border-radius: 3px;
        background: #2563eb;
    }

    .student-subtitle {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .student-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .student-actions .btn {
        font-size: .78rem;
    }

    .record-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 18px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .03);
    }

    .record-panel-header {
        padding: 16px 20px;
        background: #fbfcfe;
        border-bottom: 1px solid #e2e6eb;
        border-left: 3px solid #2563eb;
    }

    .record-panel-header.requirements {
        border-left-color: #64748b;
    }

    .record-panel-title {
        margin: 0;
        color: #1f2933;
        font-size: .95rem;
        font-weight: 600;
    }

    .record-panel-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: .74rem;
    }

    .record-panel-body {
        padding: 20px;
    }

    .form-label {
        color: #475569;
        font-size: .75rem;
        font-weight: 600;
        margin-bottom: 6px;
    }

    .form-control,
    .form-select {
        font-size: .8rem;
        border-color: #d9dee5;
    }

    .form-control:focus,
    .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .15rem rgba(37, 99, 235, .10);
    }

    .form-text {
        color: #94a3b8;
        font-size: .72rem;
        margin-top: 5px;
    }

    .validation-summary {
        margin-bottom: 18px;
    }

    .student-footer {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 22px;
        margin-bottom: 30px;
    }

    .student-footer .btn {
        font-size: .78rem;
    }

    @@media (max-width: 767.98px) {

        .student-actions {
            width: 100%;
        }

        .student-actions .btn {
            width: 100%;
        }

        .student-footer {
            flex-direction: column;
        }

        .student-footer .btn {
            width: 100%;
        }
    }
</style>


<!-- Header -->

<div class="student-header">

    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">

        <div>

            <h1 class="student-title">
                Edit Student
            </h1>

            <p class="student-subtitle">
                Update the student's information and medical requirements status.
            </p>

        </div>

        <div class="student-actions">

            <a asp-page="./Index"
               class="btn btn-outline-secondary">
                Back to Students
            </a>

        </div>

    </div>

</div>


<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger validation-summary">
    </div>


    <input type="hidden"
           asp-for="Student.StudentId" />


    <!-- Student Information -->

    <div class="record-panel">

        <div class="record-panel-header">

            <h2 class="record-panel-title">
                Student Information
            </h2>

            <p class="record-panel-description">
                Update the student's identification and academic information.
            </p>

        </div>


        <div class="record-panel-body">

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="Student.StudentNumber"
                           class="form-label">
                        Student Number
                    </label>

                    <input asp-for="Student.StudentNumber"
                           class="form-control" />

                    <span asp-validation-for="Student.StudentNumber"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Student.FullName"
                           class="form-label">
                        Full Name
                    </label>

                    <input asp-for="Student.FullName"
                           class="form-control" />

                    <span asp-validation-for="Student.FullName"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Student.DateOfBirth"
                           class="form-label">
                        Date of Birth
                    </label>

                    <input asp-for="Student.DateOfBirth"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="Student.DateOfBirth"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Student.Course"
                           class="form-label">
                        Course
                    </label>

                    <input asp-for="Student.Course"
                           class="form-control" />

                    <span asp-validation-for="Student.Course"
                          class="text-danger small">
                    </span>

                </div>


                <div class="col-md-6">

                    <label asp-for="Student.YearLevel"
                           class="form-label">
                        Year Level
                    </label>

                    <input asp-for="Student.YearLevel"
                           class="form-control" />

                    <span asp-validation-for="Student.YearLevel"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Medical Requirements -->

    <div class="record-panel">

        <div class="record-panel-header requirements">

            <h2 class="record-panel-title">
                Medical Requirements
            </h2>

            <p class="record-panel-description">
                Update the current status of the student's medical requirements.
            </p>

        </div>


        <div class="record-panel-body">

            <div class="row">

                <div class="col-md-6">

                    <label asp-for="Student.MedicalRequirementStatus"
                           class="form-label">
                        Medical Requirements Status
                    </label>

                    <select asp-for="Student.MedicalRequirementStatus"
                            class="form-select">

                        <option value="Not Submitted">
                            Not Submitted
                        </option>

                        <option value="Pending Review">
                            Pending Review
                        </option>

                        <option value="Incomplete">
                            Incomplete
                        </option>

                        <option value="Complete">
                            Complete
                        </option>

                    </select>

                    <div class="form-text">
                        This status does not restrict clinic services.
                    </div>

                    <span asp-validation-for="Student.MedicalRequirementStatus"
                          class="text-danger small">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Actions -->

    <div class="student-footer">

        <button type="submit"
                class="btn btn-primary">
            Save Changes
        </button>

        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Cancel
        </a>

    </div>

</form>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}