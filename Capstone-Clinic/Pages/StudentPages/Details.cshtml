@page
@model Capstone_Clinic.Pages.StudentPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Student</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Student.StudentNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Student.StudentNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Student.FullName)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Student.FullName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Student.Course)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Student.Course)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Student.YearLevel)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Student.YearLevel)
        </dd>
    </dl>
    <hr />

    <h4>Student Account</h4>

    @if (Model.StudentAccount == null)
    {
        <div class="alert alert-warning">
            <strong>No student account.</strong>
            This student does not have a portal account yet.
        </div>
    }
    else
    {
        <dl class="row">
            <dt class="col-sm-2">
                Email
            </dt>
            <dd class="col-sm-10">
                @Model.StudentAccount.Email
            </dd>

            <dt class="col-sm-2">
                Status
            </dt>
            <dd class="col-sm-10">
                @if (Model.StudentAccount.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </dd>
        </dl>
    }
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Student.StudentId">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
