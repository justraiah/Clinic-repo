@page
@model Capstone_Clinic.Pages.MedicalRecordPages.DeleteModel

@{
    ViewData["Title"] = "Delete Medical Record";
}

<style>
    .delete-header {
        margin-bottom: 24px;
    }

    .delete-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1e3a5f;
        margin-bottom: 5px;
        position: relative;
        padding-left: 14px;
    }

        .delete-title::before {
            content: "";
            position: absolute;
            left: 0;
            top: 4px;
            bottom: 4px;
            width: 4px;
            border-radius: 3px;
            background: #dc2626;
        }

    .delete-subtitle {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .delete-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 18px;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .03);
    }

    .delete-panel-header {
        padding: 16px 20px;
        background: #fbfcfe;
        border-bottom: 1px solid #e2e6eb;
        border-left: 3px solid #dc2626;
    }

    .delete-panel-title {
        margin: 0;
        color: #1f2933;
        font-size: .95rem;
        font-weight: 600;
    }

    .delete-panel-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: .74rem;
    }

    .delete-panel-body {
        padding: 20px;
    }

    .warning-box {
        padding: 14px 16px;
        margin-bottom: 20px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-left: 4px solid #d97706;
        border-radius: 6px;
        color: #7c2d12;
        font-size: .82rem;
        line-height: 1.5;
    }

    .record-summary {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-bottom: 22px;
    }

    .record-summary-item {
        padding: 14px;
        background: #f8fafc;
        border: 1px solid #e2e6eb;
        border-radius: 6px;
    }

    .record-summary-label {
        color: #64748b;
        font-size: .68rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: 5px;
    }

    .record-summary-value {
        color: #334155;
        font-size: .84rem;
        font-weight: 500;
        word-break: break-word;
    }

    .delete-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .delete-actions .btn {
            font-size: .78rem;
        }

    @@media (max-width: 767.98px) {

        .record-summary {
            grid-template-columns: 1fr;
        }

        .delete-actions {
            flex-direction: column;
        }

            .delete-actions .btn {
                width: 100%;
            }
    }
</style>


<!-- Header -->

<div class="delete-header">

    <h1 class="delete-title">
        Delete Medical Record
    </h1>

    <p class="delete-subtitle">
        Review the consultation information before permanently deleting this record.
    </p>

</div>


<!-- Confirmation -->

<div class="delete-panel">

    <div class="delete-panel-header">

        <h2 class="delete-panel-title">
            Confirm Deletion
        </h2>

        <p class="delete-panel-description">
            This action cannot be undone.
        </p>

    </div>


    <div class="delete-panel-body">

        <div class="warning-box">

            <strong>Warning:</strong>
            You are about to permanently delete this medical record and its consultation information.
            Confirm that this is the correct record before continuing.

        </div>


        <div class="record-summary">

            <div class="record-summary-item">

                <div class="record-summary-label">
                    Student ID
                </div>

                <div class="record-summary-value">
                    @Model.MedicalRecord.StudentId
                </div>

            </div>


            <div class="record-summary-item">

                <div class="record-summary-label">
                    Visit Date
                </div>

                <div class="record-summary-value">
                    @Model.MedicalRecord.VisitDate.ToString("MMMM dd, yyyy")
                </div>

            </div>


            <div class="record-summary-item">

                <div class="record-summary-label">
                    Chief Complaint
                </div>

                <div class="record-summary-value">
                    @Model.MedicalRecord.ChiefComplaint
                </div>

            </div>

        </div>


        <form method="post">

            <input type="hidden"
                   asp-for="MedicalRecord.MedicalRecordId" />

            <div class="delete-actions">

                <button type="submit"
                        class="btn btn-danger">
                    Delete Medical Record
                </button>

                <a asp-page="./Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>