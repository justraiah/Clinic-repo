@page
@model Capstone_Clinic.Pages.MedicalRecordPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<div class="container-xl mt-4">

    <div class="mb-4">

        <h2 class="fw-bold text-danger mb-1">
            🗑 Delete Medical Record
        </h2>

        <p class="text-muted">
            This action cannot be undone.
        </p>

    </div>

    <div class="card border-danger">

        <div class="card-header bg-danger text-white">
            Confirm Deletion
        </div>

        <div class="card-body">

            <div class="alert alert-warning mb-4">

                <strong>Warning!</strong><br />

                You are about to permanently delete this student's
                medical record and consultation information.

            </div>

            <table class="table table-borderless">

                <tr>
                    <th width="180">Student ID</th>
                    <td>@Model.MedicalRecord.StudentId</td>
                </tr>

                <tr>
                    <th>Visit Date</th>
                    <td>@Model.MedicalRecord.VisitDate.ToString("MMMM dd, yyyy")</td>
                </tr>

                <tr>
                    <th>Chief Complaint</th>
                    <td>@Model.MedicalRecord.ChiefComplaint</td>
                </tr>

            </table>
            <form method="post">

                <input type="hidden"
                       asp-for="MedicalRecord.MedicalRecordId" />

                <button type="submit"
                        class="btn btn-danger">
                    🗑 Delete Medical Record
                </button>

                <a asp-page="./Index"
                   class="btn btn-outline-secondary ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>