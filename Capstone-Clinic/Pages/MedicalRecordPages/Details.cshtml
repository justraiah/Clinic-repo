@page
@model Capstone_Clinic.Pages.MedicalRecordPages.DetailsModel

@{
    ViewData["Title"] = "Medical Record";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show mb-4"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}

<div class="container-xl mt-4">

    <div class="mb-4">

        <h2 class="fw-bold mb-1">
            📄 Medical Record
        </h2>

        <h4 class="text-primary mb-1">
            @Model.Student.FullName
        </h4>

        <p class="text-muted mb-2">
            @Model.Student.StudentNumber •
            @Model.Student.Course •
            Year @Model.Student.YearLevel
        </p>

        <small class="text-secondary">
            Last Visit:
            @Model.MedicalRecord.VisitDate.ToString("MMMM dd, yyyy")
        </small>
        <div class="row mt-4 mb-4">

            <div class="col-md-4">
                <div class="card border-danger shadow-sm">
                    <div class="card-body text-center">

                        <h2 class="text-danger">
                            @Model.CriticalVisits
                        </h2>

                        <h6>Critical Visits</h6>

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-warning shadow-sm">
                    <div class="card-body text-center">

                        <h2 class="text-warning">
                            @Model.TotalVisits
                        </h2>

                        <h6>Total Vital Records</h6>

                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card border-success shadow-sm">
                    <div class="card-body text-center">

                        @if (Model.LatestStatus == "Critical")
                        {
                            <h2 class="text-danger">
                                🔴 Critical
                            </h2>
                        }
                        else if (Model.LatestStatus == "Warning")
                        {
                            <h2 class="text-warning">
                                🟡 Warning
                            </h2>
                        }
                        else if (Model.LatestStatus == "Normal")
                        {
                            <h2 class="text-success">
                                🟢 Normal
                            </h2>
                        }
                        else
                        {
                            <h2 class="text-secondary">
                                No Records
                            </h2>
                        }

                        <h6>Latest Status</h6>

                    </div>
                </div>
            </div>

        </div>

        <div class="d-flex flex-wrap gap-3 mt-4 mb-4">

            <a asp-page="./Edit"
               asp-route-id="@Model.MedicalRecord.MedicalRecordId"
               class="btn btn-warning px-4">
                ✏ Edit Record
            </a>

            <a asp-page="./Create"
               asp-route-studentId="@Model.Student.StudentId"
               class="btn btn-primary px-4">
                ➕ New Consultation
            </a>

            <a asp-page="/VitalSignLogPages/Create"
               asp-route-medicalRecordId="@Model.MedicalRecord.MedicalRecordId"
               class="btn btn-success px-4">
                ❤️ Record Vital Signs
            </a>

            <a asp-page="/Student/Search"
               class="btn btn-outline-secondary px-4">
                ← Back to Student Lookup
            </a>

        </div>

        <div class="card border-primary mb-4">

            <div class="card-header bg-primary text-white">
                👤 Student Information
            </div>

            <div class="card-body">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <strong>Student Number</strong><br />
                        @Model.Student.StudentNumber
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Age</strong><br />
                        @Model.StudentAge years old
                    </div>

                    <div class="col-md-6 mb-3">
                        <strong>Course</strong><br />
                        @Model.Student.Course
                    </div>

                    <div class="col-md-6">
                        <strong>Year Level</strong><br />
                        @Model.Student.YearLevel
                    </div>

                </div>

            </div>

        </div>
        <div class="card border-danger mb-4">

            <div class="card-header bg-danger text-white">
                ❤️ Recent Vital Signs
            </div>

            <div class="card-body">

                @if (Model.RecentVitalSigns.Any())
                {
                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>Date</th>
                                <th>Temp</th>
                                <th>HR</th>
                                <th>RR</th>
                                <th>SpO₂</th>
                                <th>Blood Pressure</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var vital in Model.RecentVitalSigns)
                            {
                                <tr>

                                    <td>
                                        @vital.RecordedAt.ToString("MMMM dd, yyyy")
                                    </td>

                                    <td>
                                        @vital.Temperature °C
                                    </td>

                                    <td>
                                        @vital.HeartRate BPM
                                    </td>
                                    
                                    <td>
                                        @vital.RespiratoryRate breaths/min

                                    <td>
                                        @vital.OxygenSaturation %
                                    </td>

                                    <td>
                                        @vital.SystolicBP/@vital.DiastolicBP
                                    </td>
                                    <td>
                                        @if (vital.Status == "Critical")
                                        {
                                            <span class="badge bg-danger">🔴 Critical</span>
                                        }
                                        else if (vital.Status == "Warning")
                                        {
                                            <span class="badge bg-warning text-dark">🟡 Warning</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">🟢 Normal</span>
                                        }
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                    <a asp-page="/VitalSignLogPages/Index"
                       asp-route-medicalRecordId="@Model.MedicalRecord.MedicalRecordId"
                       class="btn btn-outline-danger">
                        📈 View Full History
                    </a>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No vital sign records available.
                    </p>
                }

            </div>

        </div>

    <div class="card border-success mb-4">

        <div class="card-header bg-success text-white">
            🏥 Consultation
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Visit Date
                </label>

                <input class="form-control"
                       value="@Model.MedicalRecord.VisitDate.ToString("MMMM dd, yyyy")"
                       readonly />
            </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Chief Complaint
                    </label>

                    <textarea class="form-control"
                              rows="2"
                              readonly>@Model.MedicalRecord.ChiefComplaint</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">
                        Pain Scale (0–10)
                    </label>

                    <input class="form-control"
                           value="@Model.MedicalRecord.PainScale"
                           readonly />
                </div>

                <div class="mb-0">
                <label class="form-label fw-semibold">
                    Diagnosis
                </label>

                <textarea class="form-control"
                          rows="2"
                          readonly>@Model.MedicalRecord.Diagnosis</textarea>
            </div>

        </div>

    </div>  

    <div class="card border-warning mb-4">

        <div class="card-header bg-warning text-dark">
            💊 Treatment
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label class="form-label fw-semibold">
                    Medications
                </label>

                <textarea class="form-control"
                          rows="3"
                          readonly>@Model.MedicalRecord.Medications</textarea>
            </div>

            <div class="mb-0">
                <label class="form-label fw-semibold">
                    Allergies
                </label>

                <textarea class="form-control"
                          rows="2"
                          readonly>@Model.MedicalRecord.Allergies</textarea>
            </div>

        </div>

    </div>
    <div class="card border-secondary mb-4">

        <div class="card-header bg-secondary text-white">
            📝 Clinical Notes
        </div>

        <div class="card-body">

            <textarea class="form-control"
                      rows="6"
                      readonly>@Model.MedicalRecord.ClinicalNotes</textarea>

        </div>

    </div>
        <div class="card border-info mb-4">

            <div class="card-header bg-info text-white">
                📚 Consultation History
            </div>

            <div class="card-body">

                @if (Model.ConsultationHistory.Any())
                {
                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>
                                <th>Visit Date</th>
                                <th>Chief Complaint</th>
                                <th>Diagnosis</th>
                                <th></th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var consultation in Model.ConsultationHistory)
                            {
                                <tr>

                                    <td>
                                        @consultation.VisitDate.ToString("MMMM dd, yyyy")
                                    </td>

                                    <td>
                                        @consultation.ChiefComplaint
                                    </td>

                                    <td>
                                        @consultation.Diagnosis
                                    </td>

                                    <td class="text-end">

                                        @if (consultation.MedicalRecordId != Model.MedicalRecord.MedicalRecordId)
                                        {
                                            <a asp-page="./Details"
                                               asp-route-id="@consultation.MedicalRecordId"
                                               class="btn btn-sm btn-outline-primary">
                                                Open
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Current
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No previous consultations.
                    </p>
                }

            </div>

        </div>
</div>
</div>