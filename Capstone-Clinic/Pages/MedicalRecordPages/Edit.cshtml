@page
@model Capstone_Clinic.Pages.MedicalRecordPages.EditModel

@{
    ViewData["Title"] = "Edit Medical Record";
}

<div class="container-xl mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                ✏️ Edit Consultation
            </h2>

            <p class="text-muted mb-0">
                Update the patient's consultation details.
            </p>

        </div>

        <a asp-page="./Details"
           asp-route-id="@Model.MedicalRecord.MedicalRecordId"
           class="btn btn-outline-secondary">
            ← Back to Medical Record
        </a>

    </div>

    <div class="card border-primary">

        <div class="card-body">

        <form method="post">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <input type="hidden"
                   asp-for="MedicalRecord.MedicalRecordId" />

            <input type="hidden"
                   asp-for="MedicalRecord.CreatedAt" />

            <div class="row g-3">

                <div class="col-md-6">

    <label class="form-label">
        Patient
    </label>

    <input type="text"
           class="form-control"
           value="@(Model.MedicalRecord.StudentId.HasValue
               ? Model.StudentNumber + " - " + Model.StudentName
               : Model.CommunityPatientName + " - " + Model.CommunityPatientIdentifier)"
           readonly />

    <input type="hidden"
           asp-for="MedicalRecord.StudentId" />

</div>

                <div class="col-md-6">

                    <label asp-for="MedicalRecord.VisitDate"
                           class="form-label">
                        Visit Date
                    </label>

                    <input asp-for="MedicalRecord.VisitDate"
                           class="form-control"
                           type="date" />

                    <span asp-validation-for="MedicalRecord.VisitDate"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="MedicalRecord.ChiefComplaint"
                           class="form-label">
                        Chief Complaint
                    </label>

                    <input asp-for="MedicalRecord.ChiefComplaint"
                           class="form-control" />

                    <span asp-validation-for="MedicalRecord.ChiefComplaint"
                          class="text-danger">
                    </span>

                </div>

                    <div class="col-md-6">

                        <label asp-for="MedicalRecord.PainScale"
                               class="form-label">
                            Pain Scale (0–10)
                        </label>

                        <input asp-for="MedicalRecord.PainScale"
                               class="form-control"
                               type="number"
                               min="0"
                               max="10" />

                        <span asp-validation-for="MedicalRecord.PainScale"
                              class="text-danger">
                        </span>

                    </div>

                <div class="col-md-6">

                    <label asp-for="MedicalRecord.Diagnosis"
                           class="form-label">
                        Diagnosis
                    </label>

                    <input asp-for="MedicalRecord.Diagnosis"
                           class="form-control" />

                    <span asp-validation-for="MedicalRecord.Diagnosis"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="MedicalRecord.Medications"
                           class="form-label">
                        Medications
                    </label>

                    <input asp-for="MedicalRecord.Medications"
                           class="form-control" />

                    <span asp-validation-for="MedicalRecord.Medications"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-md-6">

                    <label asp-for="MedicalRecord.Allergies"
                           class="form-label">
                        Allergies
                    </label>

                    <input asp-for="MedicalRecord.Allergies"
                           class="form-control" />

                    <span asp-validation-for="MedicalRecord.Allergies"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-12">

                    <label asp-for="MedicalRecord.ClinicalNotes"
                           class="form-label">
                        Clinical Notes
                    </label>

                    <textarea asp-for="MedicalRecord.ClinicalNotes"
                              class="form-control"
                              rows="4"></textarea>

                    <span asp-validation-for="MedicalRecord.ClinicalNotes"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="mt-4">

                <button type="submit"
                        class="btn btn-primary">
                    💾 Save Changes
                </button>

                <a asp-page="./Details"
                   asp-route-id="@Model.MedicalRecord.MedicalRecordId"
                   class="btn btn-secondary">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}