@page
@model Capstone_Clinic.Pages.MedicalRecordPages.CreateModel
@{
    ViewData["Title"] = "New Consultation";
}

<div class="container-xl mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                🩺 New Consultation
            </h2>
            <p class="text-muted mb-0">
                Create a new medical record.
            </p>
        </div>

        <a asp-page="/Student/Search"
           class="btn btn-outline-secondary">
            ← Back to Student Lookup
        </a>
    </div>

    <form method="post">

        <input type="hidden" asp-for="MedicalRecord.StudentId" />
        <input type="hidden" asp-for="MedicalRecord.CreatedAt" />
        <input type="hidden" asp-for="MedicalRecord.UpdatedAt" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <div class="card border-primary mb-4">

            <div class="card-header bg-primary text-white">
                👤 Patient Information
            </div>

            <div class="card-body">

                @if (Model.Student != null)
                {
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <strong>Full Name</strong><br />
                            @Model.Student.FullName
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Student Number</strong><br />
                            @Model.Student.StudentNumber
                        </div>

                        <div class="col-md-6">
                            <strong>Age</strong><br />
                            @Model.StudentAge years old
                        </div>

                        <div class="col-md-6">
                            <strong>Course / Year Level</strong><br />
                            @Model.Student.Course • Year @Model.Student.YearLevel
                        </div>

                    </div>
                }
                else
                {
                    <input type="hidden"
                           asp-for="MedicalRecord.ClinicPatientId" />

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                Patient Type
                            </label>

                            <select name="CommunityPatientType"
                                    class="form-select"
                                @(Model.IsExistingPatient ? "disabled" : "")>
                                <option value="Faculty"
                                        selected="@(Model.CommunityPatientType == "Faculty")">
                                    Faculty
                                </option>
                                <option value="Staff"
                                        selected="@(Model.CommunityPatientType == "Staff")">
                                    Staff
                                </option>
                                <option value="Other Community Member"
                                        selected="@(Model.CommunityPatientType == "Other Community Member")">
                                    Other Community Member
                                </option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                Full Name
                            </label>

                            <input name="CommunityFullName"
                                   value="@Model.CommunityFullName"
                                   class="form-control"
                                   placeholder="Enter full name"
                            @(Model.IsExistingPatient ? "readonly" : "") />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                Identifier
                            </label>

                            <input name="CommunityIdentifier"
                                   value="@Model.CommunityIdentifier"
                                   class="form-control"
                                   placeholder="Employee ID / other identifier"
                            @(Model.IsExistingPatient ? "readonly" : "") />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">
                                Date of Birth
                            </label>

                            <input name="CommunityDateOfBirth"
                                   value="@(Model.CommunityDateOfBirth?.ToString("yyyy-MM-dd"))"
                                   type="date"
                                   class="form-control"
                            @(Model.IsExistingPatient ? "readonly" : "") />
                        </div>

                    </div>
                }

            </div>
        </div>

        <div class="card border-success mb-4">

            <div class="card-header bg-success text-white">
                🏥 Consultation
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="MedicalRecord.VisitDate"
                           class="form-label fw-semibold">
                    </label>

                    <input asp-for="MedicalRecord.VisitDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="MedicalRecord.VisitDate"
                          class="text-danger small">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="MedicalRecord.ChiefComplaint"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="MedicalRecord.ChiefComplaint"
                              rows="3"
                              class="form-control"></textarea>

                    <span asp-validation-for="MedicalRecord.ChiefComplaint"
                          class="text-danger small">
                    </span>

                </div>

                <div class="mb-3">

                    <label asp-for="MedicalRecord.PainScale"
                           class="form-label fw-semibold">
                        Pain Scale (0–10)
                    </label>

                    <input asp-for="MedicalRecord.PainScale"
                           type="number"
                           min="0"
                           max="10"
                           class="form-control" />

                    <span asp-validation-for="MedicalRecord.PainScale"
                          class="text-danger small">
                    </span>

                </div>

                <div class="mb-0">

                    <label asp-for="MedicalRecord.Diagnosis"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="MedicalRecord.Diagnosis"
                              rows="3"
                              class="form-control"></textarea>

                    <span asp-validation-for="MedicalRecord.Diagnosis"
                          class="text-danger small">
                    </span>

                </div>

            </div>
        </div>

        <div class="card border-warning mb-4">

            <div class="card-header bg-warning">
                💊 Treatment
            </div>

            <div class="card-body">

                <div class="mb-3">

                    <label asp-for="MedicalRecord.Medications"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="MedicalRecord.Medications"
                              rows="3"
                              class="form-control"></textarea>

                </div>

                <div class="mb-0">

                    <label asp-for="MedicalRecord.Allergies"
                           class="form-label fw-semibold">
                    </label>

                    <textarea asp-for="MedicalRecord.Allergies"
                              rows="2"
                              class="form-control"></textarea>

                </div>

            </div>
        </div>

        <div class="card border-secondary mb-4">

            <div class="card-header bg-secondary text-white">
                📝 Clinical Notes
            </div>

            <div class="card-body">

                <textarea asp-for="MedicalRecord.ClinicalNotes"
                          rows="5"
                          class="form-control"></textarea>

            </div>

        </div>

        <button type="submit"
                class="btn btn-primary">
            💾 Save Consultation
        </button>

        <a asp-page="/Student/Search"
           class="btn btn-outline-secondary ms-2">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}