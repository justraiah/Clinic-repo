@page
@model Capstone_Clinic.Pages.MedicalRecordPages.IndexModel

@{
    ViewData["Title"] = "Medical Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            📄 Medical Records
        </h2>

        <p class="text-muted mb-0">
            View and manage student medical records and clinic visit information.
        </p>
    </div>

    <a asp-page="./Create"
       class="btn btn-primary">
        + Create Medical Record
    </a>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>
                        <th>Student</th>
                        <th>Visit Date</th>
                        <th>Chief Complaint</th>
                        <th>Diagnosis</th>
                        <th>Medications</th>
                        <th>Allergies</th>
                        <th>Clinical Notes</th>
                        <th>Created</th>
                        <th>Updated</th>
                        <th class="text-center">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.MedicalRecord)
                    {
                        <tr>

                            <td>
                                <strong>
                                    @(Model.StudentDisplay.ContainsKey(item.StudentId)
                                        ? Model.StudentDisplay[item.StudentId]
                                        : "Unknown Student")
                                </strong>
                            </td>

                            <td>
                                @item.VisitDate.ToString("MMM dd, yyyy")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.ChiefComplaint)
                                    ? "—"
                                    : item.ChiefComplaint)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Diagnosis)
                                    ? "—"
                                    : item.Diagnosis)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Medications)
                                    ? "—"
                                    : item.Medications)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Allergies)
                                    ? "None"
                                    : item.Allergies)
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.ClinicalNotes)
                                    ? "—"
                                    : item.ClinicalNotes)
                            </td>

                            <td>
                                @item.CreatedAt.ToString("MMM dd, yyyy")
                            </td>

                            <td>
                                @item.UpdatedAt.ToString("MMM dd, yyyy")
                            </td>

                            <td class="text-center text-nowrap">

                                <a asp-page="./Details"
                                   asp-route-id="@item.MedicalRecordId"
                                   class="btn btn-sm btn-info">
                                    View
                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@item.MedicalRecordId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@item.MedicalRecordId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>