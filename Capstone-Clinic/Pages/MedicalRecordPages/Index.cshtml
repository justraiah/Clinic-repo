@page
@model Capstone_Clinic.Pages.MedicalRecordPages.IndexModel

@{
    ViewData["Title"] = "Medical Records";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            📄 Medical Records
        </h2>

        <p class="text-muted mb-0">
            View and manage community medical records. Open a record to view consultation history, vital signs, prescriptions, and other clinic information.
        </p>
    </div>

    <div class="d-flex gap-2">

        <a asp-page="./Create"
           class="btn btn-success">
            ➕ New Consultation
        </a>

        <a asp-page="/Student/Search"
           class="btn btn-primary">
            🔍 Student Lookup
        </a>

    </div>

</div>

<div class="card shadow-sm border-0">

    <div class="card-body p-0">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>
                        <th>Patient</th>
                        <th>Record Created</th>
                        <th>Last Updated</th>
                        <th class="text-center">Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.MedicalRecord)
                    {
                        <tr>
                            <td>
                                <strong>
                                    @(item.StudentId.HasValue && Model.StudentDisplay.ContainsKey(item.StudentId.Value)
    ? Model.StudentDisplay[item.StudentId.Value]
    : Model.CommunityPatientDisplay.ContainsKey(item.ClinicPatientId)
        ? Model.CommunityPatientDisplay[item.ClinicPatientId]
        : "Community Member")
                                </strong>
                            </td>
                            <td>
                                @item.VisitDate.ToString("MMM dd, yyyy")
                            </td>

                            <td>
                                @if (item.UpdatedAt == DateTime.MinValue)
                                {
                                    <span class="text-muted">Never</span>
                                }
                                else
                                {
                                    @item.UpdatedAt.ToString("MMM dd, yyyy")
                                }
                            </td>

                            <td class="text-center text-nowrap">

                                <a asp-page="./Details"
                                   asp-route-id="@item.MedicalRecordId"
                                   class="btn btn-sm btn-info">
                                    Open Record
                                </a>

                                <a asp-page="./Edit"
                                   asp-route-id="@item.MedicalRecordId"
                                   class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-page="./Delete"
                                   asp-route-id="@item.MedicalRecordId"
                                   class="btn btn-sm btn-danger">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>