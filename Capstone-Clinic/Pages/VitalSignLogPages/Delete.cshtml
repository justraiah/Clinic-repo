@page
@model Capstone_Clinic.Pages.VitalSignLogPages.DeleteModel

@{
    ViewData["Title"] = "Delete Vital Sign Record";
}

<h1>Delete Vital Sign Record</h1>

<p class="text-muted">
    Review the information below before permanently deleting this record.
</p>

<hr/>
<div class="card border-danger shadow-sm">

    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">Delete Vital Sign Record</h4>
    </div>

    <div class="card-body">

        <p class="text-danger">
            <strong>Warning!</strong> This action cannot be undone.
        </p>

        <dl class="row">

            <dt class="col-sm-4">Medical Record ID</dt>
            <dd class="col-sm-8">
                @Model.VitalSignLog.MedicalRecordId
            </dd>

            <dt class="col-sm-4">Temperature</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.Temperature:F1} °C")
            </dd>

            <dt class="col-sm-4">Heart Rate</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.HeartRate} BPM")
            </dd>

            <dt class="col-sm-4">SpO₂</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.OxygenSaturation}%")
            </dd>

            <dt class="col-sm-4">Blood Pressure</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.SystolicBP}/{Model.VitalSignLog.DiastolicBP} mmHg")
            </dd>

            <dt class="col-sm-4">Recorded At</dt>
            <dd class="col-sm-8">
                @Model.VitalSignLog.RecordedAt.ToString("MMMM dd, yyyy hh:mm tt")
            </dd>

        </dl>

        <form method="post">

            <input type="hidden"
                   asp-for="VitalSignLog.VitalSignLogId" />

            <input type="hidden"
                   asp-for="MedicalRecordId" />

            <button type="submit"
                    class="btn btn-danger">
                Delete Record
            </button>

            <a asp-page="./Index"
               asp-route-medicalRecordId="@Model.MedicalRecordId"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>