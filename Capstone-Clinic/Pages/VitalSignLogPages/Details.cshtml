@page
@model Capstone_Clinic.Pages.VitalSignLogPages.DetailsModel

@{
    ViewData["Title"] = "Vital Sign Details";

    var statusClass = Model.VitalSignLog.Status switch
    {
        "Critical" => "status-critical",
        "Warning" => "status-warning",
        _ => "status-normal"
    };

    var statusPanelClass = Model.VitalSignLog.Status switch
    {
        "Critical" => "status-panel-critical",
        "Warning" => "status-panel-warning",
        _ => "status-panel-normal"
    };
}

<style>
    .vital-details-header {
        margin-bottom: 24px;
    }

    .vital-details-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1e3a5f;
        margin-bottom: 5px;
        position: relative;
        padding-left: 14px;
    }

    .vital-details-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4px;
        bottom: 4px;
        width: 4px;
        border-radius: 3px;
        background: #2563eb;
    }

    .vital-details-subtitle {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .details-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 18px;
    }

    .details-panel-header {
        padding: 16px 20px;
        background: #fbfcfe;
        border-bottom: 1px solid #e2e6eb;
        border-left: 3px solid #2563eb;
    }

    .details-panel-title {
        margin: 0;
        color: #1f2933;
        font-size: .95rem;
        font-weight: 600;
    }

    .details-panel-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: .74rem;
    }

    .details-panel-body {
        padding: 20px;
    }

    .patient-name {
        color: #1e3a5f;
        font-size: 1.15rem;
        font-weight: 600;
        margin: 0;
    }

    .patient-label {
        color: #94a3b8;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: 4px;
    }

    .status-panel {
        border-radius: 7px;
        padding: 15px 17px;
        border: 1px solid #e2e6eb;
        background: #ffffff;
    }

    .status-panel-normal {
        border-left: 4px solid #16a34a;
    }

    .status-panel-warning {
        border-left: 4px solid #d97706;
    }

    .status-panel-critical {
        border-left: 4px solid #dc2626;
    }

    .status-label {
        color: #64748b;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: 6px;
    }

    .status-value {
        font-size: 1.05rem;
        font-weight: 600;
    }

    .status-normal {
        color: #15803d;
    }

    .status-warning {
        color: #b45309;
    }

    .status-critical {
        color: #dc2626;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .info-item {
        padding: 14px 15px;
        background: #f8fafc;
        border: 1px solid #e2e6eb;
        border-radius: 6px;
    }

    .info-label {
        color: #64748b;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .025em;
        margin-bottom: 5px;
    }

    .info-value {
        color: #334155;
        font-size: .82rem;
        font-weight: 500;
        line-height: 1.4;
        word-break: break-word;
    }

    .measurement-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
    }

    .measurement-card {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 7px;
        padding: 15px;
        border-top: 3px solid #2563eb;
    }

    .measurement-label {
        color: #64748b;
        font-size: .7rem;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .measurement-value {
        color: #1f2933;
        font-size: 1.05rem;
        font-weight: 600;
    }

    .remarks-box {
        padding: 14px 15px;
        background: #f8fafc;
        border: 1px solid #e2e6eb;
        border-radius: 6px;
        color: #475569;
        font-size: .8rem;
        line-height: 1.5;
        min-height: 48px;
    }

    .details-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .details-actions .btn {
        font-size: .75rem;
    }

    @@media (max-width: 767.98px) {
        .info-grid,
        .measurement-grid {
            grid-template-columns: 1fr;
        }

        .details-actions .btn {
            width: 100%;
        }
    }
        .vital-comparison-section {
        margin-bottom: 22px;
    }

    .vital-comparison-heading {
        font-size: .9rem;
        font-weight: 600;
        color: #334155;
        margin-bottom: 12px;
    }

    .vital-comparison-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 12px;
    }

    .pre-card {
        border-top-color: #2563eb;
    }

    .post-card {
        border-top-color: #16a34a;
        background: #f8fffb;
    }

    .post-section-header {
        border-left-color: #16a34a;
    }

    @@media (max-width: 767.98px) {
        .vital-comparison-grid {
            grid-template-columns: 1fr;
        }
    }
    .measurement-change {
        margin-top: 8px;
        font-size: .72rem;
        color: #64748b;
        font-weight: 500;
    }
</style>


<!-- Header -->

<div class="vital-details-header">

    <h1 class="vital-details-title">
        Vital Sign Details
    </h1>

    <p class="vital-details-subtitle">
        View the recorded vital signs for this clinic visit.
    </p>

</div>


<!-- Patient & Status -->

<div class="details-panel">

    <div class="details-panel-header">

        <h2 class="details-panel-title">
            Patient Information
        </h2>

        <p class="details-panel-description">
            Patient associated with this vital-sign record.
        </p>

    </div>

    <div class="details-panel-body">

        <div class="row g-3">

            <div class="col-md-8">

                <div class="patient-label">
                    Patient
                </div>

                <p class="patient-name">
                    @Model.StudentName
                </p>

            </div>

            <div class="col-md-4">

                <div class="status-panel @statusPanelClass">

                    <div class="status-label">
                        Current Status
                    </div>

                    <div class="status-value @statusClass">
                        @Model.VitalSignLog.Status
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Visit Information -->

<div class="details-panel">

    <div class="details-panel-header">

        <h2 class="details-panel-title">
            Visit Information
        </h2>

        <p class="details-panel-description">
            Details associated with this recorded measurement.
        </p>

    </div>

    <div class="details-panel-body">

        <div class="info-grid">

            <div class="info-item">

                <div class="info-label">
                    Visit Reason
                </div>

                <div class="info-value">
                    @(string.IsNullOrWhiteSpace(Model.VitalSignLog.VisitReason)
                        ? "—"
                        : Model.VitalSignLog.VisitReason)
                </div>

            </div>

            <div class="info-item">

                <div class="info-label">
                    Recorded At
                </div>

                <div class="info-value">
                    @Model.VitalSignLog.RecordedAt.ToString("MMMM dd, yyyy hh:mm tt")
                </div>

            </div>

        </div>

    </div>

</div>

<!-- Vital Measurements -->

@{
    var vital = Model.VitalSignLog;

    var hasPost = vital.PostTemperature.HasValue
        || vital.PostHeartRate.HasValue
        || vital.PostRespiratoryRate.HasValue
        || vital.PostOxygenSaturation.HasValue
        || vital.PostSystolicBP.HasValue
        || vital.PostDiastolicBP.HasValue;
}

<div class="details-panel">

    <div class="details-panel-header">
        <h2 class="details-panel-title">Vital Measurements</h2>
        <p class="details-panel-description">
            Initial measurements and post-rest reassessment for this visit.
        </p>
    </div>

    <div class="details-panel-body">

        <!-- PRE -->
        <div class="vital-comparison-section">

            <h3 class="vital-comparison-heading">
                Initial Vital Signs (Pre)
            </h3>

            <div class="vital-comparison-grid">

                <div class="measurement-card pre-card">
                    <div class="measurement-label">Temperature</div>
                    <div class="measurement-value">
                        @($"{vital.Temperature:F1} °C")
                    </div>
                </div>

                <div class="measurement-card pre-card">
                    <div class="measurement-label">Pulse Rate</div>
                    <div class="measurement-value">
                        @($"{vital.HeartRate} BPM")
                    </div>
                </div>

                <div class="measurement-card pre-card">
                    <div class="measurement-label">Respiratory Rate</div>
                    <div class="measurement-value">
                        @($"{vital.RespiratoryRate} breaths/min")
                    </div>
                </div>

                <div class="measurement-card pre-card">
                    <div class="measurement-label">SpO₂</div>
                    <div class="measurement-value">
                        @($"{vital.OxygenSaturation}%")
                    </div>
                </div>

                <div class="measurement-card pre-card">
                    <div class="measurement-label">Blood Pressure</div>
                    <div class="measurement-value">
                        @($"{vital.SystolicBP}/{vital.DiastolicBP} mmHg")
                    </div>
                </div>

            </div>
        </div>

        <!-- POST -->
        @if (hasPost)
        {
            <div class="vital-comparison-section">

                <h3 class="vital-comparison-heading">
                    Post-Rest Reassessment (Post)
                </h3>

                <div class="vital-comparison-grid">

                    <div class="measurement-card post-card">
                        <div class="measurement-label">Temperature</div>
                        <div class="measurement-value">
                            @(vital.PostTemperature.HasValue
                                ? $"{vital.PostTemperature.Value:F1} °C"
                                : "—")
                        </div>
                        <div class="measurement-change">
                        @(vital.PostTemperature.HasValue
                            ? $"Change: {vital.PostTemperature.Value - vital.Temperature:+0.0;-0.0;0.0} °C"
                            : "Change: —")
                        </div>
                    </div>

                    <div class="measurement-card post-card">
                        <div class="measurement-label">Pulse Rate</div>
                        <div class="measurement-value">
                            @(vital.PostHeartRate.HasValue
                                ? $"{vital.PostHeartRate} BPM"
                                : "—")
                        </div>
                        <div class="measurement-change">
                        @(vital.PostHeartRate.HasValue
                            ? $"Change: {vital.PostHeartRate.Value - vital.HeartRate:+0.0;-0.0;0.0} BPM"
                            : "Change: —")
                        </div>
                    </div>

                    <div class="measurement-card post-card">
                        <div class="measurement-label">Respiratory Rate</div>
                        <div class="measurement-value">
                            @(vital.PostRespiratoryRate.HasValue
                                ? $"{vital.PostRespiratoryRate} breaths/min"
                                : "—")
                        </div>
                        <div class="measurement-change">
                        @(vital.PostRespiratoryRate.HasValue
                            ? $"Change: {vital.PostRespiratoryRate.Value - vital.RespiratoryRate:+0.0;-0.0;0.0} breaths/min"
                            : "Change: —")
                        </div>
                    </div>

                    <div class="measurement-card post-card">
                        <div class="measurement-label">SpO₂</div>
                        <div class="measurement-value">
                            @(vital.PostOxygenSaturation.HasValue
                                ? $"{vital.PostOxygenSaturation}%"
                                : "—")
                        </div>
                        <div class="measurement-change">
                        @(vital.PostOxygenSaturation.HasValue
                            ? $"Change: {vital.PostOxygenSaturation.Value - vital.OxygenSaturation:+0.0;-0.0;0.0}%"
                            : "Change: —")
                        </div>
                    </div>

                    <div class="measurement-card post-card">
                        <div class="measurement-label">Blood Pressure</div>
                        <div class="measurement-value">
                            @(vital.PostSystolicBP.HasValue && vital.PostDiastolicBP.HasValue
                                ? $"{vital.PostSystolicBP}/{vital.PostDiastolicBP} mmHg"
                                : "—")
                        </div>
                        <div class="measurement-change">
                        @(vital.PostSystolicBP.HasValue && vital.PostDiastolicBP.HasValue
                            ? $"Change: {vital.PostSystolicBP.Value - vital.SystolicBP:+0.0;-0.0;0.0}/{vital.PostDiastolicBP.Value - vital.DiastolicBP:+0.0;-0.0;0.0} mmHg"
                            : "Change: —")
                        </div>
                    </div>

                </div>
            </div>
        }
        else
        {
            <div class="alert alert-light border mt-3 mb-0">
                <span class="text-muted">
                    No post-rest reassessment has been recorded for this visit yet.
                </span>
            </div>
        }

    </div>
</div>


<!-- Record Information -->

<div class="details-panel">

    <div class="details-panel-header">

        <h2 class="details-panel-title">
            Record Information
        </h2>

        <p class="details-panel-description">
            Additional information stored with this vital-sign record.
        </p>

    </div>

    <div class="details-panel-body">

        <div class="info-grid">

            <div class="info-item">

                <div class="info-label">
                    Remarks
                </div>

                <div class="info-value">
                    @(string.IsNullOrWhiteSpace(Model.VitalSignLog.Remarks)
                        ? "—"
                        : Model.VitalSignLog.Remarks)
                </div>

            </div>

            <div class="info-item">

                <div class="info-label">
                    Recorded By
                </div>

                <div class="info-value">
                    Staff #@Model.VitalSignLog.StaffId
                </div>

            </div>

        </div>

    </div>

</div>


<!-- Actions -->

<div class="details-actions mb-4">
    <a asp-page="./Edit"
       asp-route-id="@Model.VitalSignLog.VitalSignLogId"
       asp-route-medicalRecordId="@Model.MedicalRecordId"
       class="btn btn-primary">
        Edit Record
    </a>

    <a asp-page="./Delete"
       asp-route-id="@Model.VitalSignLog.VitalSignLogId"
       asp-route-medicalRecordId="@Model.MedicalRecordId"
       class="btn btn-outline-danger">
        Delete Record
    </a>

    <a asp-page="./Index"
       asp-route-medicalRecordId="@Model.MedicalRecordId"
       class="btn btn-outline-secondary">
        Back to History
    </a>

</div>