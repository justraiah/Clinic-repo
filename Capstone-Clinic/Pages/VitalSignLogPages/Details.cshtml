@page
@model Capstone_Clinic.Pages.VitalSignLogPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class="card-body">

    <div class="mb-4">
        <h5 class="text-primary">👤 Student</h5>
        <p class="fs-5 mb-0">@Model.StudentName</p>
    </div>

    <hr />

    <div class="row">

        <div class="col-md-6 mb-3">
            <strong>🩺 Visit Reason</strong><br />
            @(string.IsNullOrWhiteSpace(Model.VitalSignLog.VisitReason)
                ? "—"
                : Model.VitalSignLog.VisitReason)
        </div>

        <div class="col-md-6 mb-3">
            <strong>📊 Status</strong><br />

            @if (Model.VitalSignLog.Status == "Critical")
            {
                <span class="badge bg-danger">🔴 Critical</span>
            }
            else if (Model.VitalSignLog.Status == "Warning")
            {
                <span class="badge bg-warning text-dark">🟡 Warning</span>
            }
            else
            {
                <span class="badge bg-success">🟢 Normal</span>
            }

        </div>

        <div class="col-md-6 mb-3">
            <strong>🌡 Temperature</strong><br />
            @($"{Model.VitalSignLog.Temperature:F1} °C")
        </div>

        <div class="col-md-6 mb-3">
            <strong>❤️ Heart Rate</strong><br />
            @($"{Model.VitalSignLog.HeartRate} BPM")
        </div>

        <div class="col-md-6 mb-3">
            <strong>🫁 SpO₂</strong><br />
            @($"{Model.VitalSignLog.OxygenSaturation}%")
        </div>

        <div class="col-md-6 mb-3">
            <strong>🩸 Blood Pressure</strong><br />
            @($"{Model.VitalSignLog.SystolicBP}/{Model.VitalSignLog.DiastolicBP} mmHg")
        </div>

        <div class="col-md-6 mb-3">
            <strong>📝 Remarks</strong><br />
            @(string.IsNullOrWhiteSpace(Model.VitalSignLog.Remarks)
                ? "—"
                : Model.VitalSignLog.Remarks)
        </div>

        <div class="col-md-6 mb-3">
            <strong>📅 Recorded At</strong><br />
            @Model.VitalSignLog.RecordedAt.ToString("MMMM dd, yyyy hh:mm tt")
        </div>

        <div class="col-md-6 mb-3">
            <strong>👨‍⚕️ Recorded By</strong><br />
            Staff #@Model.VitalSignLog.StaffId
        </div>

    </div>

</div>

<div class="mt-3">
    <a asp-page="./Edit"
       asp-route-id="@Model.VitalSignLog.VitalSignLogId"
       asp-route-medicalRecordId="@Model.MedicalRecordId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-page="./Index"
       asp-route-medicalRecordId="@Model.MedicalRecordId"
       class="btn btn-secondary">
        Back
    </a>
</div>
