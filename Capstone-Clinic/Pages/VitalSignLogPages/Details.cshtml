@page
@model Capstone_Clinic.Pages.VitalSignLogPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Vital Sign Details</h4>
    </div>

    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-4">Medical Record ID</dt>
            <dd class="col-sm-8">@Model.VitalSignLog.MedicalRecordId</dd>

            <dt class="col-sm-4">Temperature</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.Temperature:F1} °C")
            </dd>

            <dt class="col-sm-4">Heart Rate</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.HeartRate} BPM")
            </dd>

            <dt class="col-sm-4">SpO₂</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.OxygenSaturation}%")
            </dd>

            <dt class="col-sm-4">Blood Pressure</dt>
            <dd class="col-sm-8">
                @($"{Model.VitalSignLog.SystolicBP}/{Model.VitalSignLog.DiastolicBP} mmHg")
            </dd>

            <dt class="col-sm-4">Recorded At</dt>
            <dd class="col-sm-8">
                @Model.VitalSignLog.RecordedAt.ToString("MMMM dd, yyyy hh:mm tt")
            </dd>

            <dt class="col-sm-4">Recorded By</dt>
            <dd class="col-sm-8">
                Staff #@Model.VitalSignLog.StaffId
            </dd>

        </dl>

    </div>
</div>

<div class="mt-3">
    <a asp-page="./Edit"
       asp-route-id="@Model.VitalSignLog.VitalSignLogId"
       class="btn btn-warning">
        Edit
    </a>

    <a asp-page="./Index"
       class="btn btn-secondary">
        Back
    </a>
</div>
