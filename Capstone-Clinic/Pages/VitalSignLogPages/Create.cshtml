@page
@model Capstone_Clinic.Pages.VitalSignLogPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Record Vital Signs</h1>

<p class="text-muted">
    Enter the student's vital sign measurements below.
</p>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="VitalSignLog.MedicalRecordId" class="form-label">
                    Student ID
                </label>
                <input asp-for="VitalSignLog.MedicalRecordId" class="form-control" />
                <span asp-validation-for="VitalSignLog.MedicalRecordId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VitalSignLog.Temperature" class="form-label">
                    Temperature (°C)
                </label>
                <input asp-for="VitalSignLog.Temperature" class="form-control" />
                <span asp-validation-for="VitalSignLog.Temperature" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VitalSignLog.HeartRate" class="form-label">
                    Heart Rate (BPM)
                </label>
                <input asp-for="VitalSignLog.HeartRate" class="form-control" />
                <span asp-validation-for="VitalSignLog.HeartRate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VitalSignLog.OxygenSaturation" class="form-label">
                    SpO₂ (%)
                </label>
                <input asp-for="VitalSignLog.OxygenSaturation" class="form-control" />
                <span asp-validation-for="VitalSignLog.OxygenSaturation" class="text-danger"></span>
            </div>

            <label class="form-label">
                Blood Pressure (mmHg)
            </label>

            <div class="row mb-3">
                <div class="col">
                    <input asp-for="VitalSignLog.SystolicBP"
                           class="form-control"
                           placeholder="Systolic" />
                </div>

                <div class="col">
                    <input asp-for="VitalSignLog.DiastolicBP"
                           class="form-control"
                           placeholder="Diastolic" />
                </div>
            </div>



            <div class="mb-3">
                <input type="hidden" asp-for="VitalSignLog.StaffId" value="1" />
            </div>
            <button type="submit" class="btn btn-success">
                Save Vital Signs
            </button>

            <a asp-page="./Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
