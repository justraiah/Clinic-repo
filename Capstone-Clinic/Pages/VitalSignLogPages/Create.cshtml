@page
@model Capstone_Clinic.Pages.VitalSignLogPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<p class="text-muted">
    Record the student's vital signs. Heart Rate and SpO₂ can be captured from the sensor, while Temperature and Blood Pressure are entered manually.
</p>

<hr />
<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    Record Student Vital Signs
                </h4>
            </div>

            <div class="card-body">

                <form method="post">
            <h5 class="mb-3 text-primary">
                📡 Sensor Readings
            </h5>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @if (!string.IsNullOrEmpty(Model.StudentName))
                    {
                        <div class="card border-primary mb-4">

                            <div class="card-header bg-primary text-white">
                                👤 Student Information
                            </div>

                            <div class="card-body">

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Student Number
                                    </label>

                                    <input class="form-control"
                                           value="@Model.StudentNumber"
                                           readonly />
                                </div>

                                <div class="mb-0">
                                    <label class="form-label fw-semibold">
                                        Student Name
                                    </label>

                                    <input class="form-control"
                                           value="@Model.StudentName"
                                           readonly />
                                </div>

                                <input type="hidden"
                                       asp-for="VitalSignLog.MedicalRecordId" />

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="SelectedStudentId" class="form-label">
                                Student
                            </label>

                            <select asp-for="SelectedStudentId"
                                    asp-items="Model.StudentList"
                                    class="form-select">

                                <option value="">-- Select Student --</option>

                            </select>

                            <span asp-validation-for="SelectedStudentId"
                                  class="text-danger"></span>
                        </div>
                    }

            <div class="mb-3">
                <label asp-for="VitalSignLog.HeartRate" class="form-label">
                    Heart Rate (BPM)
                </label>
                <input asp-for="VitalSignLog.HeartRate"
                       class="form-control"
                       readonly
                       placeholder="Press 'Read Sensor'" />
                <span asp-validation-for="VitalSignLog.HeartRate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VitalSignLog.OxygenSaturation" class="form-label">
                    SpO₂ (%)
                </label>
                <input asp-for="VitalSignLog.OxygenSaturation"
                       class="form-control"
                       readonly
                       placeholder="Press 'Read Sensor'" />
                <span asp-validation-for="VitalSignLog.OxygenSaturation" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <button type="button"
                        class="btn btn-outline-primary w-100"
                        disabled>
                    📡 Read Sensor (Coming Soon)
                </button>
            </div>

            <hr />

            <h5 class="mb-3 text-success">
                ✍️ Manual Measurements
            </h5>

                    <div class="form-group mb-3">

                        <label asp-for="VitalSignLog.VisitReason" class="form-label">
                            Visit Reason
                        </label>

                        <input asp-for="VitalSignLog.VisitReason"
                               class="form-control"
                               placeholder="Example: Fever, Headache, Medical Clearance" />

                        <span asp-validation-for="VitalSignLog.VisitReason"
                              class="text-danger">
                        </span>

                    </div>
            <div class="mb-3">
                <label asp-for="VitalSignLog.Temperature" class="form-label">
                    Temperature (°C)
                </label>

                <input asp-for="VitalSignLog.Temperature"
                       class="form-control" />

                <span asp-validation-for="VitalSignLog.Temperature"
                      class="text-danger"></span>
            </div>

                    <div class="row mb-3">

                        <div class="col-md-6">
                            <label asp-for="VitalSignLog.SystolicBP"
                                   class="form-label fw-semibold">
                                Systolic Pressure (mmHg)
                            </label>

                            <input asp-for="VitalSignLog.SystolicBP"
                                   class="form-control"
                                   placeholder="e.g. 120" />

                            <span asp-validation-for="VitalSignLog.SystolicBP"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="VitalSignLog.DiastolicBP"
                                   class="form-label fw-semibold">
                                Diastolic Pressure (mmHg)
                            </label>

                            <input asp-for="VitalSignLog.DiastolicBP"
                                   class="form-control"
                                   placeholder="e.g. 80" />

                            <span asp-validation-for="VitalSignLog.DiastolicBP"
                                  class="text-danger"></span>
                        </div>

                    </div>



            <div class="mb-3">
                <input type="hidden" asp-for="VitalSignLog.StaffId" value="1" />
            </div>
            <button type="submit" class="btn btn-success px-4">
                💾 Save Vital Signs
            </button>

                    <a asp-page="/MedicalRecordPages/Details"
                       asp-route-id="@Model.VitalSignLog.MedicalRecordId"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
