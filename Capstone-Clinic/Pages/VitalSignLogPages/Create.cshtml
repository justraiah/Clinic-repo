@page
@model Capstone_Clinic.Pages.VitalSignLogPages.CreateModel

@{
    ViewData["Title"] = "Record Vital Signs";
}

<style>
    .vital-create-header {
        margin-bottom: 24px;
    }

    .vital-create-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1e3a5f;
        margin-bottom: 5px;
        position: relative;
        padding-left: 14px;
    }

    .vital-create-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4px;
        bottom: 4px;
        width: 4px;
        border-radius: 3px;
        background: #2563eb;
    }

    .vital-create-subtitle {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .form-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 18px;
    }

    .form-panel-header {
        padding: 16px 20px;
        background: #fbfcfe;
        border-bottom: 1px solid #e2e6eb;
        border-left: 3px solid #2563eb;
    }

    .form-panel-title {
        margin: 0;
        color: #1f2933;
        font-size: .95rem;
        font-weight: 600;
    }

    .form-panel-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: .74rem;
    }

    .form-panel-body {
        padding: 20px;
    }

    .patient-panel {
        background: #f8fafc;
        border: 1px solid #e2e6eb;
        border-radius: 7px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .patient-label {
        color: #64748b;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: 5px;
    }

    .patient-value {
        color: #1e3a5f;
        font-size: .9rem;
        font-weight: 600;
    }

    .measurement-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .measurement-field {
        padding: 15px;
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 7px;
    }

    .measurement-field label {
        color: #475569;
        font-size: .76rem;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .measurement-field .form-control {
        font-size: .82rem;
        border-color: #d8dee6;
    }

    .measurement-field .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .15rem rgba(37, 99, 235, .10);
    }

    .sensor-section {
        border-top: 3px solid #2563eb;
    }

    .manual-section {
        border-top: 3px solid #64748b;
    }

    .sensor-note {
        color: #64748b;
        font-size: .74rem;
        margin-bottom: 14px;
    }

    .sensor-action {
        margin-top: 14px;
    }

    .sensor-action .btn {
        font-size: .78rem;
    }

    .manual-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .manual-grid .full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        color: #475569;
        font-size: .76rem;
        font-weight: 600;
    }

    .form-control {
        font-size: .82rem;
        border-color: #d8dee6;
    }

    .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .15rem rgba(37, 99, 235, .10);
    }

    .text-danger.field-validation-error,
    .validation-summary-errors {
        font-size: .72rem;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
    }

    .form-actions .btn {
        font-size: .75rem;
    }

    .sensor-loading {
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        color: #1e40af;
        font-size: .76rem;
    }
    .measurement-monitor {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        background: #f8fafc;
    }

    .measurement-progress-track {
        height: 8px;
        background: #e2e8f0;
        border-radius: 10px;
        overflow: hidden;
    }

    .measurement-progress-fill {
        height: 100%;
        width: 0%;
        background: #2563eb;
        transition: width .3s ease;
    }

    .measurement-window {
        display: grid;
        grid-template-columns: 75px 1fr 110px;
        align-items: center;
        gap: 10px;
        padding: 10px 0;
        border-bottom: 1px solid #e2e8f0;
        font-size: .78rem;
    }

        .measurement-window:last-child {
            border-bottom: none;
        }

    .window-accepted {
        color: #16a34a;
        font-weight: 600;
    }

    .window-rejected {
        color: #dc2626;
        font-weight: 600;
    }

    .window-pending {
        color: #94a3b8;
    }

    @@media (max-width: 767.98px) {
        .measurement-grid,
        .manual-grid {
            grid-template-columns: 1fr;
        }

        .manual-grid .full-width {
            grid-column: auto;
        }

        .form-actions .btn {
            width: 100%;
        }
        .status-dot {
            display: inline-block;
            width: 9px;
            height: 9px;
            border-radius: 50%;
            flex-shrink: 0;
        }

            .status-dot.online {
                background: #16a34a;
            }

            .status-dot.offline {
                background: #dc2626;
            }
    }
</style>


<!-- Header -->

<div class="vital-create-header">

    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">

        <div>

            <h1 class="vital-create-title">
                Record Vital Signs
            </h1>

            <p class="vital-create-subtitle">
                Record the patient's vital signs during the consultation.
            </p>

        </div>

        <a asp-page="/MedicalRecordPages/Details"
           asp-route-id="@Model.VitalSignLog.MedicalRecordId"
           class="btn btn-outline-secondary">
            Back to Medical Record
        </a>

    </div>

</div>


<form method="post"
      asp-page="/VitalSignLogPages/Create">


    <!-- Patient Information -->

    <div class="form-panel">

        <div class="form-panel-header">

            <h2 class="form-panel-title">
                Patient Information
            </h2>

            <p class="form-panel-description">
                Patient associated with this vital-sign record.
            </p>

        </div>

        <div class="form-panel-body">

            @if (!string.IsNullOrEmpty(Model.StudentName))
            {
                <div class="patient-panel">

                    <div class="row g-3">

                        <div class="col-md-5">

                            <div class="patient-label">
                                Patient Identifier
                            </div>

                            <div class="patient-value">
                                @Model.StudentNumber
                            </div>

                        </div>

                        <div class="col-md-7">

                            <div class="patient-label">
                                Patient Name
                            </div>

                            <div class="patient-value">
                                @Model.StudentName
                            </div>

                        </div>

                    </div>

                </div>

                <input type="hidden"
                       asp-for="VitalSignLog.MedicalRecordId" />
            }
            else
            {
                <div class="mb-0">

                    <label asp-for="SelectedStudentId"
                           class="form-label">
                        Student
                    </label>

                    <select asp-for="SelectedStudentId"
                            asp-items="Model.StudentList"
                            class="form-select">

                        <option value="">
                            -- Select Student --
                        </option>

                    </select>

                    <span asp-validation-for="SelectedStudentId"
                          class="text-danger">
                    </span>

                </div>
            }

        </div>

    </div>


    <!-- Messages -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>

    <!-- Monitoring Time -->
    <div class="form-panel">
        <div class="form-panel-header">
            <h2 class="form-panel-title">Patient Monitoring</h2>
            <p class="form-panel-description">
                Start monitoring before recording the patient's initial vital signs.
            </p>
        </div>

        <div class="form-panel-body">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <button type="button"
                        id="startMonitoringBtn"
                        class="btn btn-success">
                    <i class="bi bi-clock"></i> Start Monitoring (Time In)
                </button>

                <strong id="monitoringTimeDisplay" class="text-muted">
                    Monitoring not started
                </strong>
            </div>
        </div>
    </div>

    <!-- Sensor Readings -->

    <div class="form-panel sensor-section">

        <div class="form-panel-header">

            <h2 class="form-panel-title">
                Pre-Consultation — Sensor Readings
            </h2>

            <p class="form-panel-description">
                Initial pulse rate and oxygen saturation readings before consultation.
            </p>

        </div>

        <div class="form-panel-body">

            <div class="sensor-note">
                The sensor must be on Wi-Fi with internet access. Place a finger on it, then request a reading.
                Values may also be entered manually if necessary.
            </div>
            <div class="mb-3 d-flex align-items-center gap-2">
                <span class="status-dot @(Model.IoTDeviceStatus == "Connected" ? "online" : "offline")"></span>
                <strong class="small">ESP32 Sensor:</strong>
                <span class="small @(Model.IoTDeviceStatus == "Connected" ? "text-success" : "text-danger")">
                    @Model.IoTDeviceStatus
                </span>
            </div>

            <div class="measurement-grid">

                <div class="measurement-field">

                    <label asp-for="VitalSignLog.HeartRate"
                           class="form-label">
                        Pulse Rate (BPM)
                    </label>

                    <input asp-for="VitalSignLog.HeartRate"
                           class="form-control"
                           type="number"
                           min="1"
                           max="300"
                           placeholder="e.g. 70" />

                    <span asp-validation-for="VitalSignLog.HeartRate"
                          class="text-danger">
                    </span>

                </div>

                <div class="measurement-field">

                    <label asp-for="VitalSignLog.OxygenSaturation"
                           class="form-label">
                        SpO₂ (%)
                    </label>

                    <input asp-for="VitalSignLog.OxygenSaturation"
                           class="form-control"
                           type="number"
                           min="1"
                           max="100"
                           placeholder="e.g. 99" />

                    <span asp-validation-for="VitalSignLog.OxygenSaturation"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="sensor-action">

                
                <button type="button"
                        class="btn btn-primary"
                        id="readSensorBtn">
                    Read Pulse Rate &amp; SpO₂
                </button>

            </div>

            <div id="sensorLoading"
                 class="alert sensor-loading mt-3 d-none">

                <div class="d-flex align-items-center">

                    <div class="spinner-border spinner-border-sm me-2"
                         role="status">
                    </div>

                    <div>

                        <strong id="sensorLoadingTitle">Reading sensor...</strong><br />

                        <span id="sensorLoadingDetail">Please keep your finger on the sensor.</span>

                    </div>

                </div>

            </div>

            
            <!-- Live Measurement Modal -->
            <div class="modal fade"
                 id="measurementModal"
                 tabindex="-1"
                 aria-labelledby="measurementModalTitle"
                 aria-hidden="true"
                 data-bs-backdrop="static"
                 data-bs-keyboard="false">

                <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">

                    <div class="modal-content">

                        <div class="modal-header">
                            <div>
                                <h5 class="modal-title" id="measurementModalTitle">
                                    Live Sensor Measurement
                                </h5>
                                <small class="text-muted">
                                    Keep your finger still on the sensor.
                                </small>
                            </div>
                        </div>

                        <div class="modal-body">

                            <div id="measurementMonitor" class="measurement-monitor">

                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <strong class="small">Measurement Progress</strong>
                                    <span id="measurementProgressCount" class="small text-muted">
                                        0 / 8 windows
                                    </span>
                                </div>

                                <div class="measurement-progress-track mb-3">
                                    <div id="measurementProgressBar"
                                         class="measurement-progress-fill">
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between small mb-2">
                                    <span class="text-success" id="acceptedCount">Accepted: 0</span>
                                    <span class="text-danger" id="rejectedCount">Rejected: 0</span>
                                </div>

                                <div id="measurementProgressRows"></div>

                                <div id="measurementFinalResult"
                                     class="alert alert-success mt-3 mb-0 d-none">
                                </div>

                            </div>

                        </div>

                        <div class="modal-footer">
                            <button type="button"
                                    class="btn btn-primary"
                                    id="useSensorReadingBtn"
                                    disabled>
                                Use This Reading
                            </button>
                        </div>

                    </div>

                </div>
            </div>


        </div>

    </div>

    <!-- Manual Measurements -->

    <div class="form-panel manual-section">

        <div class="form-panel-header">

            <h2 class="form-panel-title">
                Pre-Consultation — Manual Measurements
            </h2>

            <p class="form-panel-description">
                Record the patient's initial temperature, respiratory rate, blood pressure, and visit reason.
            </p>

        </div>

        <div class="form-panel-body">

            <div class="manual-grid">

                <div class="full-width">

                    <label asp-for="VitalSignLog.VisitReason"
                           class="form-label">
                        Visit Reason
                    </label>

                    <input asp-for="VitalSignLog.VisitReason"
                           class="form-control"
                           placeholder="Example: Fever, Headache, Medical Clearance" />

                    <span asp-validation-for="VitalSignLog.VisitReason"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.Temperature"
                           class="form-label">
                        Temperature (°C)
                    </label>

                    <input asp-for="VitalSignLog.Temperature"
                           class="form-control"
                           placeholder="e.g. 36.5" />

                    <span asp-validation-for="VitalSignLog.Temperature"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.RespiratoryRate"
                           class="form-label">
                        Respiratory Rate (breaths/min)
                    </label>

                    <input asp-for="VitalSignLog.RespiratoryRate"
                           class="form-control"
                           type="number"
                           min="1"
                           max="100"
                           placeholder="e.g. 16" />

                    <span asp-validation-for="VitalSignLog.RespiratoryRate"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.SystolicBP"
                           class="form-label">
                        Systolic Pressure (mmHg)
                    </label>

                    <input asp-for="VitalSignLog.SystolicBP"
                           class="form-control"
                           placeholder="e.g. 120" />

                    <span asp-validation-for="VitalSignLog.SystolicBP"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.DiastolicBP"
                           class="form-label">
                        Diastolic Pressure (mmHg)
                    </label>

                    <input asp-for="VitalSignLog.DiastolicBP"
                           class="form-control"
                           placeholder="e.g. 80" />

                    <span asp-validation-for="VitalSignLog.DiastolicBP"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>

    <!-- Hidden Staff -->

    <input type="hidden"
           asp-for="VitalSignLog.StaffId"
           value="1" />
    <input type="hidden"
           asp-for="VitalSignLog.TimeIn"
           id="timeInInput" />

    <!-- Actions -->

    <div class="form-actions mb-4">

        <button type="submit"
                class="btn btn-primary px-4">
            Save Vital Signs
        </button>

        <a asp-page="/MedicalRecordPages/Details"
           asp-route-id="@Model.VitalSignLog.MedicalRecordId"
           class="btn btn-outline-secondary">
            Cancel
        </a>

    </div>

</form>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sensorButton = document.getElementById("readSensorBtn");
            const sensorLoading = document.getElementById("sensorLoading");
            const loadingTitle = document.getElementById("sensorLoadingTitle");
            const loadingDetail = document.getElementById("sensorLoadingDetail");
            const heartRateInput = document.getElementById("VitalSignLog_HeartRate");
            const spo2Input = document.getElementById("VitalSignLog_OxygenSaturation");
            const measurementMonitor = document.getElementById("measurementMonitor");
            const progressBar = document.getElementById("measurementProgressBar");
            const progressCount = document.getElementById("measurementProgressCount");
            const progressRows = document.getElementById("measurementProgressRows");
            const acceptedCount = document.getElementById("acceptedCount");
            const rejectedCount = document.getElementById("rejectedCount");
            const finalResult = document.getElementById("measurementFinalResult");
                    const measurementModalElement =
            document.getElementById("measurementModal");

        const measurementModal = measurementModalElement
            ? bootstrap.Modal.getOrCreateInstance(measurementModalElement)
            : null;

        const useSensorReadingBtn =
            document.getElementById("useSensorReadingBtn");

        const loadingSpinner =
            sensorLoading?.querySelector(".spinner-border");

        let completedReading = null;

            if (!sensorButton) return;

            function setLoading(title, detail) {
                if (loadingTitle) loadingTitle.textContent = title;
                if (loadingDetail) loadingDetail.textContent = detail;
                sensorLoading?.classList.remove("d-none");
            }

            function showSensorError(message) {
            measurementModal?.hide();

            sensorLoading?.classList.remove("d-none");
            loadingSpinner?.classList.add("d-none");

            sensorButton.disabled = false;
            sensorButton.textContent = "Read Pulse Rate & SpO₂";

            window.alert(message);
           }

            async function readJson(response) {
                try {
                    return await response.json();
                } catch {
                    return null;
                }
            }
                    useSensorReadingBtn?.addEventListener("click", function () {
            if (!completedReading) return;

            if (heartRateInput) {
                heartRateInput.value = completedReading.heartRate;
            }

            if (spo2Input) {
                spo2Input.value = completedReading.spo2;
            }

            measurementModal?.hide();

            sensorButton.disabled = false;
            sensorButton.textContent = "Read Pulse Rate & SpO₂";

            loadingSpinner?.classList.add("d-none");

            setLoading(
                "Sensor reading received.",
                completedReading.heartRate +
                " BPM Pulse Rate, SpO₂ " +
                completedReading.spo2 +
                "%. Review the form, then save."
            );
        });

                    function renderMeasurementProgress(data) {
            if (!data || !Array.isArray(data.updates)) return;

            measurementMonitor?.classList.remove("d-none");

                    const updates = data.updates;

        const total = updates.length > 0
            ? updates[0].totalWindows
            : 5;

        const completed = updates.length;
            const accepted = updates.filter(x => x.accepted).length;
            const rejected = updates.filter(x => !x.accepted).length;

            if (progressCount) {
                progressCount.textContent = `${completed} / ${total} windows`;
            }

            if (progressBar) {
                progressBar.style.width =
                    `${Math.min(100, completed / total * 100)}%`;
            }

            if (acceptedCount) {
                acceptedCount.textContent = `Accepted: ${accepted}`;
            }

            if (rejectedCount) {
                rejectedCount.textContent = `Rejected: ${rejected}`;
            }

            if (!progressRows) return;

            progressRows.replaceChildren();

            for (let i = 1; i <= total; i++) {
                const reading = updates.find(x => x.windowNumber === i);

                const row = document.createElement("div");
                row.className = "measurement-window";

                const windowLabel = document.createElement("strong");
                windowLabel.textContent = `Window ${i}`;

                const values = document.createElement("span");
                const status = document.createElement("span");
                        if (!reading) {
            values.textContent = "Awaiting actual reading...";
            status.textContent = "Pending";
            status.className = "window-pending";
        } else {
            const hr = reading.validHeartRate
                ? `${reading.heartRate} BPM`
                : "Invalid Pulse Rate";

            const spo2 = reading.validSpO2
                ? `${reading.spo2}%`
                : "Invalid SpO₂";

            values.textContent = `${hr} · ${spo2}`;

            status.textContent = reading.accepted
                ? "Accepted"
                : "Rejected";

            status.className = reading.accepted
                ? "window-accepted"
                : "window-rejected";

            row.title = reading.message || "";
        }

                row.append(windowLabel, values, status);
                progressRows.appendChild(row);
            }
        }

        async function refreshMeasurementProgress(requestId) {
            try {
                const response = await fetch(
                    `/api/iot/vital-signs/requests/${requestId}/progress`,
                    {
                        headers: {
                            "Accept": "application/json"
                        }
                    }
                );

                if (!response.ok) {
                    console.warn("Progress polling failed:", response.status);
                    return;
                }

                const data = await readJson(response);
                renderMeasurementProgress(data);

            } catch (error) {
                console.warn("Could not retrieve measurement progress:", error);
            }
        }

            sensorButton.addEventListener("click", async function () {
                sensorButton.disabled = true;
                sensorButton.textContent = "Reading Sensor...";
                        completedReading = null;

        useSensorReadingBtn.disabled = true;

        finalResult.classList.add("d-none");

        renderMeasurementProgress({
            updates: []
        });

        loadingSpinner?.classList.remove("d-none");
        sensorLoading?.classList.add("d-none");

        measurementModal?.show();
                setLoading(
                    "Requesting a measurement...",
                    "The clinic sensor will pick this up on its next poll."
                );

                let requestId = "";

                try {
                    const created = await fetch("/api/iot/vital-signs/requests", {
                        method: "POST",
                        headers: { "Accept": "application/json" }
                    });
                    const createdBody = await readJson(created);

                    if (!created.ok || !createdBody?.requestId) {
                        showSensorError("The CMS could not create a sensor request. Sign in again and retry.");
                        return;
                    }

                    requestId = createdBody.requestId;
                } catch {
                    showSensorError("The CMS could not be reached. Check that this page is the live site, then retry.");
                    return;
                }

                setLoading(
                    "Reading sensor...",
                    "Keep a finger still on the MAX30102 until the values appear."
                );

                const deadline = Date.now() + 150000;

                while (Date.now() < deadline) {
                    await new Promise(function (resolve) { setTimeout(resolve, 2000); });
                    await refreshMeasurementProgress(requestId);

                    try {
                        const readingResponse = await fetch(
                            "/api/iot/vital-signs/requests/" + requestId + "/reading",
                            { headers: { "Accept": "application/json" } }
                        );
                        const reading = await readJson(readingResponse);

                    if (readingResponse.status === 200 && reading?.success) {

                        completedReading = reading;

                        await refreshMeasurementProgress(requestId);

                        finalResult.textContent =
                            `Final Average: Pulse Rate ${reading.heartRate} BPM · SpO₂ ${reading.spo2}%`;

                        finalResult.classList.remove("d-none");

                        useSensorReadingBtn.disabled = false;

                        return;
                    }

                        if (readingResponse.status === 409) {
                            showSensorError(reading?.message || "The sensor did not return a usable reading.");
                            return;
                        }

                        if (readingResponse.status === 401) {
                            showSensorError("Your CMS session expired. Sign in again, then retry the reading.");
                            return;
                        }
                    } catch {
                        showSensorError("Lost contact with the CMS while waiting for the sensor.");
                        return;
                    }
                }

                showSensorError("The sensor did not return a reading in time. Confirm it is powered, on Wi-Fi, and pointed at this live CMS, then retry.");
                        });

            // ---------------- MONITORING TIME IN ----------------

            const startMonitoringBtn = document.getElementById("startMonitoringBtn");
            const monitoringTimeDisplay = document.getElementById("monitoringTimeDisplay");

            let monitoringStarted = false;

            startMonitoringBtn.addEventListener("click", function () {
                if (monitoringStarted) return;

            const now = new Date();

            const formattedTime = now.toLocaleTimeString("en-PH", {
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: true
            });

            document.getElementById("timeInInput").value =
                now.getFullYear() + "-" +
                String(now.getMonth() + 1).padStart(2, "0") + "-" +
                String(now.getDate()).padStart(2, "0") + "T" +
                String(now.getHours()).padStart(2, "0") + ":" +
                String(now.getMinutes()).padStart(2, "0") + ":" +
                String(now.getSeconds()).padStart(2, "0");

                monitoringTimeDisplay.textContent = "Monitoring started at " + formattedTime;

                monitoringTimeDisplay.classList.remove("text-muted");
                monitoringTimeDisplay.classList.add("text-success");

                startMonitoringBtn.disabled = true;
                startMonitoringBtn.innerHTML = '<i class="bi bi-check-circle"></i> Monitoring Started';

                monitoringStarted = true;
            });

        });
    </script>
}