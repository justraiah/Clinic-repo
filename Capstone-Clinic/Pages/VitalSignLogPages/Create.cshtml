@page
@model Capstone_Clinic.Pages.VitalSignLogPages.CreateModel

@{
    ViewData["Title"] = "Record Vital Signs";
}

<style>
    .vital-create-header {
        margin-bottom: 24px;
    }

    .vital-create-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1e3a5f;
        margin-bottom: 5px;
        position: relative;
        padding-left: 14px;
    }

    .vital-create-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4px;
        bottom: 4px;
        width: 4px;
        border-radius: 3px;
        background: #2563eb;
    }

    .vital-create-subtitle {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .form-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
        margin-bottom: 18px;
    }

    .form-panel-header {
        padding: 16px 20px;
        background: #fbfcfe;
        border-bottom: 1px solid #e2e6eb;
        border-left: 3px solid #2563eb;
    }

    .form-panel-title {
        margin: 0;
        color: #1f2933;
        font-size: .95rem;
        font-weight: 600;
    }

    .form-panel-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: .74rem;
    }

    .form-panel-body {
        padding: 20px;
    }

    .patient-panel {
        background: #f8fafc;
        border: 1px solid #e2e6eb;
        border-radius: 7px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .patient-label {
        color: #64748b;
        font-size: .7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        margin-bottom: 5px;
    }

    .patient-value {
        color: #1e3a5f;
        font-size: .9rem;
        font-weight: 600;
    }

    .measurement-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .measurement-field {
        padding: 15px;
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 7px;
    }

    .measurement-field label {
        color: #475569;
        font-size: .76rem;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .measurement-field .form-control {
        font-size: .82rem;
        border-color: #d8dee6;
    }

    .measurement-field .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .15rem rgba(37, 99, 235, .10);
    }

    .sensor-section {
        border-top: 3px solid #2563eb;
    }

    .manual-section {
        border-top: 3px solid #64748b;
    }

    .sensor-note {
        color: #64748b;
        font-size: .74rem;
        margin-bottom: 14px;
    }

    .sensor-action {
        margin-top: 14px;
    }

    .sensor-action .btn {
        font-size: .78rem;
    }

    .manual-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .manual-grid .full-width {
        grid-column: 1 / -1;
    }

    .form-label {
        color: #475569;
        font-size: .76rem;
        font-weight: 600;
    }

    .form-control {
        font-size: .82rem;
        border-color: #d8dee6;
    }

    .form-control:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 .15rem rgba(37, 99, 235, .10);
    }

    .text-danger.field-validation-error,
    .validation-summary-errors {
        font-size: .72rem;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 20px;
    }

    .form-actions .btn {
        font-size: .75rem;
    }

    .sensor-loading {
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        color: #1e40af;
        font-size: .76rem;
    }

    @@media (max-width: 767.98px) {
        .measurement-grid,
        .manual-grid {
            grid-template-columns: 1fr;
        }

        .manual-grid .full-width {
            grid-column: auto;
        }

        .form-actions .btn {
            width: 100%;
        }
    }
</style>


<!-- Header -->

<div class="vital-create-header">

    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">

        <div>

            <h1 class="vital-create-title">
                Record Vital Signs
            </h1>

            <p class="vital-create-subtitle">
                Record the patient's vital signs during the consultation.
            </p>

        </div>

        <a asp-page="/MedicalRecordPages/Details"
           asp-route-id="@Model.VitalSignLog.MedicalRecordId"
           class="btn btn-outline-secondary">
            Back to Medical Record
        </a>

    </div>

</div>


<form method="post"
      asp-page="/VitalSignLogPages/Create">


    <!-- Patient Information -->

    <div class="form-panel">

        <div class="form-panel-header">

            <h2 class="form-panel-title">
                Patient Information
            </h2>

            <p class="form-panel-description">
                Patient associated with this vital-sign record.
            </p>

        </div>

        <div class="form-panel-body">

            @if (!string.IsNullOrEmpty(Model.StudentName))
            {
                <div class="patient-panel">

                    <div class="row g-3">

                        <div class="col-md-5">

                            <div class="patient-label">
                                Patient Identifier
                            </div>

                            <div class="patient-value">
                                @Model.StudentNumber
                            </div>

                        </div>

                        <div class="col-md-7">

                            <div class="patient-label">
                                Patient Name
                            </div>

                            <div class="patient-value">
                                @Model.StudentName
                            </div>

                        </div>

                    </div>

                </div>

                <input type="hidden"
                       asp-for="VitalSignLog.MedicalRecordId" />
            }
            else
            {
                <div class="mb-0">

                    <label asp-for="SelectedStudentId"
                           class="form-label">
                        Student
                    </label>

                    <select asp-for="SelectedStudentId"
                            asp-items="Model.StudentList"
                            class="form-select">

                        <option value="">
                            -- Select Student --
                        </option>

                    </select>

                    <span asp-validation-for="SelectedStudentId"
                          class="text-danger">
                    </span>

                </div>
            }

        </div>

    </div>


    <!-- Messages -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <!-- Sensor Readings -->

    <div class="form-panel sensor-section">

        <div class="form-panel-header">

            <h2 class="form-panel-title">
                Sensor Readings
            </h2>

            <p class="form-panel-description">
                Heart rate and oxygen saturation can be obtained from the connected sensor.
            </p>

        </div>

        <div class="form-panel-body">

            <div class="sensor-note">
                Use the sensor reading function when the device is available.
                Values may also be entered manually if necessary.
            </div>

            <div class="measurement-grid">

                <div class="measurement-field">

                    <label asp-for="VitalSignLog.HeartRate"
                           class="form-label">
                        Heart Rate (BPM)
                    </label>

                    <input asp-for="VitalSignLog.HeartRate"
                           class="form-control"
                           type="number"
                           min="1"
                           max="300"
                           placeholder="e.g. 70" />

                    <span asp-validation-for="VitalSignLog.HeartRate"
                          class="text-danger">
                    </span>

                </div>

                <div class="measurement-field">

                    <label asp-for="VitalSignLog.OxygenSaturation"
                           class="form-label">
                        SpO₂ (%)
                    </label>

                    <input asp-for="VitalSignLog.OxygenSaturation"
                           class="form-control"
                           type="number"
                           min="1"
                           max="100"
                           placeholder="e.g. 99" />

                    <span asp-validation-for="VitalSignLog.OxygenSaturation"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="sensor-action">

                <button type="submit"
                        asp-page-handler="ReadSensor"
                        class="btn btn-primary"
                        id="readSensorBtn">

                    Read Heart Rate &amp; SpO₂

                </button>

            </div>

            <div id="sensorLoading"
                 class="alert sensor-loading mt-3 d-none">

                <div class="d-flex align-items-center">

                    <div class="spinner-border spinner-border-sm me-2"
                         role="status">
                    </div>

                    <div>

                        <strong>Reading sensor...</strong><br />

                        Please keep your finger on the sensor.

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Manual Measurements -->

    <div class="form-panel manual-section">

        <div class="form-panel-header">

            <h2 class="form-panel-title">
                Manual Measurements
            </h2>

            <p class="form-panel-description">
                Enter the remaining measurements and consultation information.
            </p>

        </div>

        <div class="form-panel-body">

            <div class="manual-grid">

                <div class="full-width">

                    <label asp-for="VitalSignLog.VisitReason"
                           class="form-label">
                        Visit Reason
                    </label>

                    <input asp-for="VitalSignLog.VisitReason"
                           class="form-control"
                           placeholder="Example: Fever, Headache, Medical Clearance" />

                    <span asp-validation-for="VitalSignLog.VisitReason"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.Temperature"
                           class="form-label">
                        Temperature (°C)
                    </label>

                    <input asp-for="VitalSignLog.Temperature"
                           class="form-control"
                           placeholder="e.g. 36.5" />

                    <span asp-validation-for="VitalSignLog.Temperature"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.RespiratoryRate"
                           class="form-label">
                        Respiratory Rate (breaths/min)
                    </label>

                    <input asp-for="VitalSignLog.RespiratoryRate"
                           class="form-control"
                           type="number"
                           min="1"
                           max="100"
                           placeholder="e.g. 16" />

                    <span asp-validation-for="VitalSignLog.RespiratoryRate"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.SystolicBP"
                           class="form-label">
                        Systolic Pressure (mmHg)
                    </label>

                    <input asp-for="VitalSignLog.SystolicBP"
                           class="form-control"
                           placeholder="e.g. 120" />

                    <span asp-validation-for="VitalSignLog.SystolicBP"
                          class="text-danger">
                    </span>

                </div>


                <div>

                    <label asp-for="VitalSignLog.DiastolicBP"
                           class="form-label">
                        Diastolic Pressure (mmHg)
                    </label>

                    <input asp-for="VitalSignLog.DiastolicBP"
                           class="form-control"
                           placeholder="e.g. 80" />

                    <span asp-validation-for="VitalSignLog.DiastolicBP"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Hidden Staff -->

    <input type="hidden"
           asp-for="VitalSignLog.StaffId"
           value="1" />


    <!-- Actions -->

    <div class="form-actions mb-4">

        <button type="submit"
                class="btn btn-primary px-4">
            Save Vital Signs
        </button>

        <a asp-page="/MedicalRecordPages/Details"
           asp-route-id="@Model.VitalSignLog.MedicalRecordId"
           class="btn btn-outline-secondary">
            Cancel
        </a>

    </div>

</form>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.querySelector("form").addEventListener("submit", function (event) {

            const submitter = event.submitter;

            if (!submitter || submitter.id !== "readSensorBtn") {
                return;
            }

            const button = document.getElementById("readSensorBtn");

            if (button) {

                button.disabled = true;

                button.innerHTML =
                    "Reading Sensor...";

                const loading = document.getElementById("sensorLoading");

                if (loading) {
                    loading.classList.remove("d-none");
                }

            }

        });

    </script>

}