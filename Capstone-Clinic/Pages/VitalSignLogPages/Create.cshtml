@page
@model Capstone_Clinic.Pages.VitalSignLogPages.CreateModel

@{
    ViewData["Title"] = "Record Vital Signs";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold mb-1">
            ❤️ Record Vital Signs
        </h2>

        <p class="text-muted mb-0">
            Record the student's vital signs during the consultation.
        </p>
    </div>

    <a asp-page="/MedicalRecordPages/Details"
       asp-route-id="@Model.VitalSignLog.MedicalRecordId"
       class="btn btn-outline-secondary">
        ← Back to Medical Record
    </a>

</div>
<div class="row justify-content-center">
    <div class="col-lg-8">

        <div class="card shadow">

            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">
                    Vital Signs Recording
                </h4>
            </div>

            <div class="card-body">

                <form method="post"
                      asp-page="/VitalSignLogPages/Create">
            <h5 class="mb-3 text-primary">
                📡 Sensor Readings
            </h5>
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">
                            @TempData["SuccessMessage"]
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">
                            @TempData["ErrorMessage"]
                        </div>
                    }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @if (!string.IsNullOrEmpty(Model.StudentName))
                    {
                        <div class="card border-primary mb-4">

                            <div class="card-header bg-primary text-white">
                                👤 Student Information
                            </div>

                            <div class="card-body">

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">
                                        Student Number
                                    </label>

                                    <input class="form-control"
                                           value="@Model.StudentNumber"
                                           readonly />
                                </div>

                                <div class="mb-0">
                                    <label class="form-label fw-semibold">
                                        Student Name
                                    </label>

                                    <input class="form-control"
                                           value="@Model.StudentName"
                                           readonly />
                                </div>

                                <input type="hidden"
                                       asp-for="VitalSignLog.MedicalRecordId" />

                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <label asp-for="SelectedStudentId" class="form-label">
                                Student
                            </label>

                            <select asp-for="SelectedStudentId"
                                    asp-items="Model.StudentList"
                                    class="form-select">

                                <option value="">-- Select Student --</option>

                            </select>

                            <span asp-validation-for="SelectedStudentId"
                                  class="text-danger"></span>
                        </div>
                    }

            <div class="mb-3">
                <label asp-for="VitalSignLog.HeartRate" class="form-label">
                    Heart Rate (BPM)
                </label>
                <input asp-for="VitalSignLog.HeartRate"
                       class="form-control"
                       readonly
                       placeholder="Press 'Read Sensor'" />
                <span asp-validation-for="VitalSignLog.HeartRate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="VitalSignLog.OxygenSaturation" class="form-label">
                    SpO₂ (%)
                </label>
                <input asp-for="VitalSignLog.OxygenSaturation"
                       class="form-control"
                       readonly
                       placeholder="Press 'Read Sensor'" />
                <span asp-validation-for="VitalSignLog.OxygenSaturation" class="text-danger"></span>
            </div>

                    <div class="mb-4">

                        <button type="submit"
                                asp-page-handler="ReadSensor"
                                class="btn btn-primary w-100"
                                id="readSensorBtn">

                            📡 Read Heart Rate & SpO₂

                        </button>
                        <div id="sensorLoading"
                             class="alert alert-info mt-3 d-none">

                            <div class="d-flex align-items-center">

                                <div class="spinner-border spinner-border-sm me-2"
                                     role="status">
                                </div>

                                <div>

                                    <strong>Reading sensor...</strong><br />

                                    Please keep your finger on the sensor.

                                </div>

                            </div>

                        </div>

                    </div>

            <hr />

            <h5 class="mb-3 text-success">
                ✍️ Manual Measurements
            </h5>

                    <div class="form-group mb-3">

                        <label asp-for="VitalSignLog.VisitReason" class="form-label">
                            Visit Reason
                        </label>

                        <input asp-for="VitalSignLog.VisitReason"
                               class="form-control"
                               placeholder="Example: Fever, Headache, Medical Clearance" />

                        <span asp-validation-for="VitalSignLog.VisitReason"
                              class="text-danger">
                        </span>

                    </div>
            <div class="mb-3">
                <label asp-for="VitalSignLog.Temperature" class="form-label">
                    Temperature (°C)
                </label>

                <input asp-for="VitalSignLog.Temperature"
                       class="form-control" />

                <span asp-validation-for="VitalSignLog.Temperature"
                      class="text-danger"></span>
            </div>

                    <div class="row mb-3">

                        <div class="col-md-6">
                            <label asp-for="VitalSignLog.SystolicBP"
                                   class="form-label fw-semibold">
                                Systolic Pressure (mmHg)
                            </label>

                            <input asp-for="VitalSignLog.SystolicBP"
                                   class="form-control"
                                   placeholder="e.g. 120" />

                            <span asp-validation-for="VitalSignLog.SystolicBP"
                                  class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="VitalSignLog.DiastolicBP"
                                   class="form-label fw-semibold">
                                Diastolic Pressure (mmHg)
                            </label>

                            <input asp-for="VitalSignLog.DiastolicBP"
                                   class="form-control"
                                   placeholder="e.g. 80" />

                            <span asp-validation-for="VitalSignLog.DiastolicBP"
                                  class="text-danger"></span>
                        </div>

                    </div>



            <div class="mb-3">
                <input type="hidden" asp-for="VitalSignLog.StaffId" value="1" />
            </div>
            <button type="submit" class="btn btn-success px-4">
                💾 Save Vital Signs
            </button>

                    <a asp-page="/MedicalRecordPages/Details"
                       asp-route-id="@Model.VitalSignLog.MedicalRecordId"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </form>

            </div>

        </div>

    </div>
</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        document.querySelector("form").addEventListener("submit", function () {

            const button = document.getElementById("readSensorBtn");

            if (button) {

                button.disabled = true;

                button.innerHTML =
                    "⏳ Reading Sensor...";

                document
                    .getElementById("sensorLoading")
                    .classList
                    .remove("d-none");

            }

        });

    </script>

}