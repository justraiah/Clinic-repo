@page
@model Capstone_Clinic.Pages.VitalSignLogPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Vital Signs</h1>

<p class="text-muted">
    Update the recorded vital sign information.
</p>
<hr />

<div class="row">
    <div class="col-md-4">
        <form method="post">

            <input type="hidden" asp-for="VitalSignLog.VitalSignLogId" />
            <input type="hidden" asp-for="VitalSignLog.StaffId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="VitalSignLog.MedicalRecordId" class="form-label">
                    Medical Record ID
                </label>

                <input asp-for="VitalSignLog.MedicalRecordId"
                       class="form-control"
                       readonly />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Temperature (°C)
                </label>

                <input asp-for="VitalSignLog.Temperature"
                       class="form-control"
                       min="30"
                       max="45"
                       step="0.1" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    Heart Rate (BPM)
                </label>

                <input asp-for="VitalSignLog.HeartRate"
                       class="form-control"
                       min="20"
                       max="250" />
            </div>

            <div class="mb-3">
                <label class="form-label">
                    SpO₂ (%)
                </label>

                <input asp-for="VitalSignLog.OxygenSaturation"
                       class="form-control"
                       min="0"
                       max="100" />
            </div>

            <label class="form-label">
                Blood Pressure
            </label>

            <div class="row mb-3">

                <div class="col">
                    <input asp-for="VitalSignLog.SystolicBP"
                           class="form-control"
                           placeholder="Systolic" />
                </div>

                <div class="col">
                    <input asp-for="VitalSignLog.DiastolicBP"
                           class="form-control"
                           placeholder="Diastolic" />
                </div>

            </div>

            <div class="mb-3">
                <label class="form-label">
                    Recorded At
                </label>

                <input asp-for="VitalSignLog.RecordedAt"
                       class="form-control"
                       readonly />
            </div>

            <button type="submit"
                    class="btn btn-warning">
                Update Vital Signs
            </button>

            <a asp-page="./Index"
               asp-route-medicalRecordId="@Model.VitalSignLog.MedicalRecordId"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
