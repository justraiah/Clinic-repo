@page
@model Capstone_Clinic.Pages.VitalSignLogPages.IndexModel

@{
    ViewData["Title"] = "Vital Sign Logs";
}

<h1>Vital Sign Logs</h1>

<p class="text-muted">
    View and manage students' recorded vital signs.
</p>

<p>
    <a asp-page="Create" class="btn btn-primary">
        + Record Vital Signs
    </a>
</p>
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Temperature</th>
            <th>Heart Rate</th>
            <th>SpO₂</th>
            <th>Blood Pressure</th>
            <th>Recorded At</th>
            <th>Staff ID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.VitalSignLog) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.MedicalRecordId)
            </td>
                <td class="text-center">
                    @($"{item.Temperature:F1} °C")
            </td>
                <td class="text-center">
                    @($"{item.HeartRate} BPM")
            </td>
            <td class="text-center">
                    @($"{item.OxygenSaturation}%")
            </td>
            <td class="text-center">
                    @($"{item.SystolicBP}/{item.DiastolicBP} mmHg")
            </td>
            <td>
                    @item.RecordedAt.ToString("MMM dd, yyyy hh:mm tt")
            </td>
            <td>
                @Html.DisplayFor(model => item.StaffId)
            </td>
                <td>
                    <a class="btn btn-sm btn-info"
                       asp-page="./Details"
                       asp-route-id="@item.VitalSignLogId">
                        View
                    </a>

                    <a class="btn btn-sm btn-warning"
                       asp-page="./Edit"
                       asp-route-id="@item.VitalSignLogId">
                        Edit
                    </a>

                    <a class="btn btn-sm btn-danger"
                       asp-page="./Delete"
                       asp-route-id="@item.VitalSignLogId">
                        Delete
                    </a>
                </td>
        </tr>
}
    </tbody>
</table>
