@page
@model Capstone_Clinic.Pages.VitalSignLogPages.IndexModel

@{
    ViewData["Title"] = "Vital Sign Logs";
}

<style>
    .vitals-header {
        margin-bottom: 24px;
    }

    .vitals-title {
        font-size: 1.7rem;
        font-weight: 600;
        color: #1e3a5f;
        margin-bottom: 5px;
        position: relative;
        padding-left: 14px;
    }

    .vitals-title::before {
        content: "";
        position: absolute;
        left: 0;
        top: 4px;
        bottom: 4px;
        width: 4px;
        border-radius: 3px;
        background: #2563eb;
    }

    .vitals-subtitle {
        color: #64748b;
        font-size: .88rem;
        margin: 0;
    }

    .vitals-description {
        color: #94a3b8;
        font-size: .76rem;
        margin-top: 7px;
    }

    .vitals-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

    .summary-card {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 7px;
        padding: 17px;
        border-top: 3px solid #2563eb;
        box-shadow: 0 1px 2px rgba(15, 23, 42, .03);
    }

    .summary-card.critical-card {
        border-top-color: #dc2626;
    }

    .summary-card.warning-card {
        border-top-color: #d97706;
    }

    .summary-card.normal-card {
        border-top-color: #16a34a;
    }

    .summary-card.neutral-card {
        border-top-color: #64748b;
    }

    .summary-label {
        color: #64748b;
        font-size: .72rem;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .summary-value {
        color: #1f2933;
        font-size: 1.35rem;
        font-weight: 600;
        line-height: 1.2;
    }

    .summary-value.critical {
        color: #dc2626;
    }

    .summary-value.warning {
        color: #b45309;
    }

    .summary-value.normal {
        color: #15803d;
    }

    .summary-note {
        margin-top: 5px;
        color: #94a3b8;
        font-size: .68rem;
    }

    .vitals-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 20px;
    }

    .vitals-actions .btn {
        font-size: .75rem;
    }

    .vitals-panel {
        background: #ffffff;
        border: 1px solid #e2e6eb;
        border-radius: 8px;
        overflow: hidden;
    }

    .vitals-panel-header {
        padding: 16px 20px;
        border-bottom: 1px solid #e2e6eb;
        background: #fbfcfe;
        border-left: 3px solid #2563eb;
    }

    .vitals-panel-title {
        margin: 0;
        color: #1f2933;
        font-size: .95rem;
        font-weight: 600;
    }

    .vitals-panel-description {
        margin: 3px 0 0;
        color: #94a3b8;
        font-size: .74rem;
    }

    .vitals-table {
        margin: 0;
    }

    .vitals-table thead th {
        background: #f8fafc;
        color: #64748b;
        font-size: .69rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .03em;
        padding: 11px 12px;
        border-bottom: 1px solid #e2e6eb;
        white-space: nowrap;
    }

    .vitals-table tbody td {
        color: #475569;
        font-size: .76rem;
        padding: 12px;
        border-bottom: 1px solid #eef0f2;
        vertical-align: middle;
    }

    .vitals-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .vitals-table tbody tr:hover {
        background: #f8fafc;
    }

    .patient-number {
        color: #334155;
        font-weight: 600;
    }

    .patient-name {
        color: #64748b;
        font-size: .72rem;
    }

    .status-badge {
        display: inline-block;
        padding: 4px 8px;
        border-radius: 4px;
        font-size: .65rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-normal {
        color: #166534;
        background: #dcfce7;
    }

    .status-warning {
        color: #92400e;
        background: #fef3c7;
    }

    .status-critical {
        color: #991b1b;
        background: #fee2e2;
    }

    .reason-badge {
        display: inline-block;
        max-width: 180px;
        padding: 4px 7px;
        border-radius: 4px;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: .65rem;
        font-weight: 500;
    }

    .action-group {
        display: flex;
        justify-content: flex-end;
        gap: 5px;
        white-space: nowrap;
    }

    .action-group .btn {
        font-size: .68rem;
    }

    .empty-state {
        padding: 45px 20px;
        text-align: center;
        color: #94a3b8;
        font-size: .78rem;
    }

    .empty-state-title {
        display: block;
        margin-bottom: 4px;
        color: #475569;
        font-size: .9rem;
        font-weight: 600;
    }

    @@media (max-width: 991.98px) {
        .vitals-summary {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 767.98px) {
        .vitals-summary {
            grid-template-columns: 1fr;
        }

        .vitals-actions .btn {
            width: 100%;
        }

        .action-group {
            justify-content: flex-start;
            flex-wrap: wrap;
        }
    }
</style>


@if (!string.IsNullOrEmpty(Model.StudentName))
{
    <!-- Patient Header -->

    <div class="vitals-header">

        <h1 class="vitals-title">
            Vital Sign History
        </h1>

        <p class="vitals-subtitle">
            @Model.StudentName
        </p>

        <p class="vitals-description">
            Showing all recorded vital signs for this patient.
        </p>

    </div>


    <!-- Summary -->

    <div class="vitals-summary">

        <div class="summary-card">

            <div class="summary-label">
                Total Visits
            </div>

            <div class="summary-value">
                @Model.TotalVisits
            </div>

            <div class="summary-note">
                Vital-sign records
            </div>

        </div>


        <div class="summary-card critical-card">

            <div class="summary-label">
                Critical Visits
            </div>

            <div class="summary-value critical">
                @Model.CriticalVisits
            </div>

            <div class="summary-note">
                Require immediate attention
            </div>

        </div>


        <div class="summary-card @(Model.LatestStatus == "Critical" ? "critical-card" : Model.LatestStatus == "Warning" ? "warning-card" : "normal-card")">

            <div class="summary-label">
                Latest Status
            </div>

            @if (Model.LatestStatus == "Critical")
            {
                <div class="summary-value critical">
                    Critical
                </div>
            }
            else if (Model.LatestStatus == "Warning")
            {
                <div class="summary-value warning">
                    Warning
                </div>
            }
            else
            {
                <div class="summary-value normal">
                    Normal
                </div>
            }

            <div class="summary-note">
                Most recent classification
            </div>

        </div>


        <div class="summary-card neutral-card">

            <div class="summary-label">
                Last Visit
            </div>

            <div class="summary-value">
                @(Model.LastVisitDate?.ToString("MMM dd") ?? "N/A")
            </div>

            <div class="summary-note">
                @(Model.LastVisitDate?.ToString("yyyy") ?? "No visit recorded")
            </div>

        </div>

    </div>


    <!-- Actions -->

    <div class="vitals-actions">

        <a asp-page="/VitalSignLogPages/Create"
           asp-route-medicalRecordId="@Model.MedicalRecordId"
           class="btn btn-primary">
            Record New Vital Signs
        </a>

        <a asp-page="/MedicalRecordPages/Details"
           asp-route-id="@Model.MedicalRecordId"
           class="btn btn-outline-secondary">
            Back to Medical Record
        </a>

    </div>
}
else
{
    <!-- General Vital Sign Header -->

    <div class="vitals-header">

        <h1 class="vitals-title">
            Vital Sign Logs
        </h1>

        <p class="vitals-subtitle">
            Review recorded vital signs across registered patients.
        </p>

    </div>
}


<!-- Main Table -->

<div class="vitals-panel">

    <div class="vitals-panel-header">

        <h2 class="vitals-panel-title">
            @(Model.MedicalRecordId == null ? "Patient Vital Sign Records" : "Vital Sign History")
        </h2>

        <p class="vitals-panel-description">
            @(Model.MedicalRecordId == null
                ? "Select a patient to view their recorded vital signs."
                : "Recorded measurements for the selected patient.")
        </p>

    </div>


    <div class="table-responsive">

        @if (Model.MedicalRecordId == null)
        {
            @if (Model.StudentSummaries.Any())
            {
                <table class="table vitals-table align-middle">

                    <thead>

                        <tr>
                            <th>Student</th>
                            <th class="text-center">Latest Status</th>
                            <th class="text-center">Total Records</th>
                            <th class="text-center">Critical Visits</th>
                            <th class="text-center">Last Recorded</th>
                            <th class="text-end">Action</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var student in Model.StudentSummaries)
                        {
                            <tr>

                                <td>

                                    <div class="patient-number">
                                        @student.StudentNumber
                                    </div>

                                    <div class="patient-name">
                                        @student.StudentName
                                    </div>

                                </td>


                                <td class="text-center">

                                    @if (student.LatestStatus == "Critical")
                                    {
                                        <span class="status-badge status-critical">
                                            Critical
                                        </span>
                                    }
                                    else if (student.LatestStatus == "Warning")
                                    {
                                        <span class="status-badge status-warning">
                                            Warning
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-normal">
                                            Normal
                                        </span>
                                    }

                                </td>


                                <td class="text-center fw-semibold">
                                    @student.TotalRecords
                                </td>


                                <td class="text-center">

                                    @if (student.CriticalCount > 0)
                                    {
                                        <span class="status-badge status-critical">
                                            @student.CriticalCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-normal">
                                            0
                                        </span>
                                    }

                                </td>


                                <td class="text-center">

                                    @(student.LastRecorded == default
                                        ? "No Records"
                                        : student.LastRecorded.ToString("MMM dd, yyyy"))

                                </td>


                                <td>

                                    <div class="action-group">

                                        <a asp-page="./Index"
                                           asp-route-medicalRecordId="@student.MedicalRecordId"
                                           class="btn btn-sm btn-outline-primary">
                                            View History
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">

                    <span class="empty-state-title">
                        No vital-sign records found
                    </span>

                    No patient vital-sign records are currently available.

                </div>
            }
        }
        else
        {
            @if (Model.VitalSigns.Any())
            {
                <table class="table vitals-table align-middle">

                    <thead>

                        <tr>
                            <th>Visit Reason</th>
                            <th class="text-center">Temp</th>
                            <th class="text-center">HR</th>
                            <th class="text-center">RR</th>
                            <th class="text-center">SpO₂</th>
                            <th class="text-center">BP</th>
                            <th class="text-center">Recorded</th>
                            <th class="text-center">Status</th>
                            <th class="text-end">Actions</th>
                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model.VitalSigns)
                        {
                            <tr>

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.VisitReason))
                                    {
                                        <span class="text-muted">
                                            N/A
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="reason-badge">
                                            @item.VisitReason
                                        </span>
                                    }

                                </td>


                                <td class="text-center">
                                    @($"{item.Temperature:F1} °C")
                                </td>


                                <td class="text-center">
                                    @($"{item.HeartRate} BPM")
                                </td>


                                <td class="text-center">
                                    @($"{item.RespiratoryRate} breaths/min")
                                </td>


                                <td class="text-center">
                                    @($"{item.OxygenSaturation}%")
                                </td>


                                <td class="text-center">
                                    @($"{item.SystolicBP}/{item.DiastolicBP} mmHg")
                                </td>


                                <td class="text-center">
                                    @item.RecordedAt.ToString("MMM dd, yyyy hh:mm tt")
                                </td>


                                <td class="text-center">

                                    @if (item.Status == "Normal")
                                    {
                                        <span class="status-badge status-normal">
                                            Normal
                                        </span>
                                    }
                                    else if (item.Status == "Warning")
                                    {
                                        <span class="status-badge status-warning">
                                            Warning
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-critical">
                                            Critical
                                        </span>
                                    }

                                </td>


                                <td>

                                    <div class="action-group">

                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-page="./Details"
                                           asp-route-id="@item.VitalSignLogId"
                                           asp-route-medicalRecordId="@Model.MedicalRecordId">
                                            View
                                        </a>

                                        <a class="btn btn-sm btn-outline-secondary"
                                           asp-page="./Edit"
                                           asp-route-id="@item.VitalSignLogId"
                                           asp-route-medicalRecordId="@Model.MedicalRecordId">
                                            Edit
                                        </a>

                                        <a class="btn btn-sm btn-outline-danger"
                                           asp-page="./Delete"
                                           asp-route-id="@item.VitalSignLogId"
                                           asp-route-medicalRecordId="@Model.MedicalRecordId">
                                            Delete
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">

                    <span class="empty-state-title">
                        No vital-sign records found
                    </span>

                    No measurements have been recorded for this patient yet.

                </div>
            }
        }

    </div>

</div>