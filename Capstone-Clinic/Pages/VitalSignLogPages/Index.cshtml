@page
@model Capstone_Clinic.Pages.VitalSignLogPages.IndexModel

@{
    ViewData["Title"] = "Vital Sign Logs";
}

@if (!string.IsNullOrEmpty(Model.StudentName))
{
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2 class="fw-bold mb-1">
                ❤️ Vital Sign History
            </h2>

            <p class="text-muted mb-0">
                @Model.StudentName
            </p>
        </div>
    </div>

    <p class="text-secondary">
        Showing all recorded vital signs for this student.
    </p>

    <div class="row mb-4">

        <div class="col-md-3">
            <div class="card border-primary shadow-sm">
                <div class="card-body text-center">
                    <h2 class="text-primary">@Model.TotalVisits</h2>
                    <h6>Total Visits</h6>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-danger shadow-sm">
                <div class="card-body text-center">
                    <h2 class="text-danger">@Model.CriticalVisits</h2>
                    <h6>Critical Visits</h6>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-warning shadow-sm">
                <div class="card-body text-center">

                    @if (Model.LatestStatus == "Critical")
                    {
                        <h2 class="text-danger">Critical</h2>
                    }
                    else if (Model.LatestStatus == "Warning")
                    {
                        <h2 class="text-warning">Warning</h2>
                    }
                    else
                    {
                        <h2 class="text-success">Normal</h2>
                    }

                    <h6>Latest Status</h6>

                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-success shadow-sm">
                <div class="card-body text-center">

                    <h2 class="text-success">
                        📅
                    </h2>

                    <h6>Last Visit</h6>

                    <small class="text-muted">
                        @(Model.LastVisitDate?.ToString("MMMM dd, yyyy") ?? "N/A")
                    </small>

                </div>
            </div>
        </div>

    </div>

    <div class="d-flex gap-2 mb-3">

        <a asp-page="/VitalSignLogPages/Create"
           asp-route-medicalRecordId="@Model.MedicalRecordId"
           class="btn btn-danger">
            ❤️ Record New Vital Signs
        </a>

        <a asp-page="/MedicalRecordPages/Details"
           asp-route-id="@Model.MedicalRecordId"
           class="btn btn-outline-secondary">
            ← Back to Medical Record
        </a>

    </div>
}
else
{
    <h2 class="fw-bold">
        ❤️ Vital Sign Logs
    </h2>

    <p class="text-muted">
        View and manage students' recorded vital signs.
    </p>
}
<div class="table-responsive">

    @if (Model.MedicalRecordId == null)
    {
        <table class="table table-striped table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Student</th>
                    <th class="text-center">Latest Status</th>
                    <th class="text-center">Total Records</th>
                    <th class="text-center">Critical Visits</th>
                    <th class="text-center">Last Recorded</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var student in Model.StudentSummaries)
                {
                    <tr>

                        <td>
                            <strong>@student.StudentNumber</strong><br />
                            <span class="text-muted">@student.StudentName</span>
                        </td>

                        <td class="text-center">

                            @if (student.LatestStatus == "Critical")
                            {
                                <span class="badge bg-danger">🔴 Critical</span>
                            }
                            else if (student.LatestStatus == "Warning")
                            {
                                <span class="badge bg-warning text-dark">🟡 Warning</span>
                            }
                            else
                            {
                                <span class="badge bg-success">🟢 Normal</span>
                            }

                        </td>

                        <td class="text-center fw-bold">
                            @student.TotalRecords
                        </td>

                        <td class="text-center">

                            @if (student.CriticalCount > 0)
                            {
                                <span class="badge bg-danger">@student.CriticalCount</span>
                            }
                            else
                            {
                                <span class="badge bg-success">0</span>
                            }

                        </td>

                        <td class="text-center">

                            @(student.LastRecorded == default
                                ? "No Records"
                                : student.LastRecorded.ToString("MMMM dd, yyyy"))

                        </td>

                        <td class="text-center">

                            <a asp-page="./Index"
                               asp-route-medicalRecordId="@student.MedicalRecordId"
                               class="btn btn-primary btn-sm">
                                View History
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }
    else
    {
        <table class="table table-striped table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th class="text-center">Visit Reason</th>
                    <th class="text-center">Temp</th>
                    <th class="text-center">HR</th>
                    <th class="text-center">RR</th>
                    <th class="text-center">SpO₂</th>
                    <th class="text-center">BP</th>
                    <th class="text-center">Recorded</th>
                    <th class="text-center">Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model.VitalSigns)
                {
                    <tr>

                        <td>
                            @if (string.IsNullOrWhiteSpace(item.VisitReason))
                            {
                                <span class="text-muted">N/A</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-dark">
                                    @item.VisitReason
                                </span>
                            }
                        </td>

                        <td class="text-center">@($"{item.Temperature:F1} °C")</td>

                        <td class="text-center">@($"{item.HeartRate} BPM")</td>

                        <td class="text-center">@($"{item.RespiratoryRate} breaths/min")</td>

                        <td class="text-center">@($"{item.OxygenSaturation}%")</td>

                        <td class="text-center">@($"{item.SystolicBP}/{item.DiastolicBP} mmHg")</td>

                        <td class="text-center">
                            @item.RecordedAt.ToString("MMMM dd, yyyy hh:mm tt")
                        </td>

                        <td class="text-center">

                            @if (item.Status == "Normal")
                            {
                                <span class="badge bg-success">🟢 Normal</span>
                            }
                            else if (item.Status == "Warning")
                            {
                                <span class="badge bg-warning text-dark">🟡 Warning</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">🔴 Critical</span>
                            }

                        </td>

                        <td class="text-center">

                            <a class="btn btn-sm btn-info"
                               asp-page="./Details"
                               asp-route-id="@item.VitalSignLogId"
                               asp-route-medicalRecordId="@Model.MedicalRecordId">
                                View
                            </a>

                            <a class="btn btn-sm btn-warning"
                               asp-page="./Edit"
                               asp-route-id="@item.VitalSignLogId"
                               asp-route-medicalRecordId="@Model.MedicalRecordId">
                                Edit
                            </a>

                            <a class="btn btn-sm btn-danger"
                               asp-page="./Delete"
                               asp-route-id="@item.VitalSignLogId"
                               asp-route-medicalRecordId="@Model.MedicalRecordId">
                                Delete
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>
    }

</div>