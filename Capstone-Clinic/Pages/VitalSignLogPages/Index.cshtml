@page
@model Capstone_Clinic.Pages.VitalSignLogPages.IndexModel

@{
    ViewData["Title"] = "Vital Sign Logs";
}

@if (!string.IsNullOrEmpty(Model.StudentName))
{
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h2 class="fw-bold mb-1">
                ❤️ Vital Sign History
            </h2>

            <p class="text-muted mb-0">
                @Model.StudentName
            </p>
        </div>

        <a asp-page="/Student/Search"
           class="btn btn-outline-secondary">
            ← Back to Student Lookup
        </a>

    </div>

    <p class="text-secondary">
        Showing all recorded vital signs for this student.
    </p>

    <a asp-page="/VitalSignLogPages/Create"
       asp-route-medicalRecordId="@Model.MedicalRecordId"
       class="btn btn-danger mb-3">
        ❤️ Record New Vital Signs
    </a>
}
else
{
    <h2 class="fw-bold">
        ❤️ Vital Sign Logs
    </h2>

    <p class="text-muted">
        View and manage students' recorded vital signs.
    </p>
}

<p>
    <a asp-page="Create" class="btn btn-primary">
        + Record Vital Signs
    </a>
</p>
<table class="table table-striped table-hover align-middle">
    <thead>
        <tr>
            @if (Model.MedicalRecordId == null)
            {
                <th>
                    Student
                </th>
            }
            <th>Temperature</th>
            <th>Heart Rate</th>
            <th>SpO₂</th>
            <th>Blood Pressure</th>
            <th>Recorded At</th>
            <th>Status</th>
            <th>Staff ID</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.VitalSigns)
        {
        <tr>
                @if (Model.MedicalRecordId == null)
                {
                    <td>
                        @item.Student
                    </td>
                }
                <td class="text-center">
                    @($"{item.Temperature:F1} °C")
            </td>
                <td class="text-center">
                    @($"{item.HeartRate} BPM")
            </td>
            <td class="text-center">
                    @($"{item.OxygenSaturation}%")
            </td>
            <td class="text-center">
                    @($"{item.SystolicBP}/{item.DiastolicBP} mmHg")
            </td>
                <td>
                    @item.RecordedAt.ToString("MMM dd, yyyy hh:mm tt")
                </td>

                <td>
                    @if (item.Status == "Normal")
                    {
                        <span class="badge bg-success">
                            🟢 Normal
                        </span>
                    }
                    else if (item.Status == "Warning")
                    {
                        <span class="badge bg-warning text-dark">
                            🟡 Warning
                        </span>
                    }
                    else if (item.Status == "Critical")
                    {
                        <span class="badge bg-danger">
                            🔴 Critical
                        </span>
                    }
                </td>

                <td>
                    @Html.DisplayFor(model => item.StaffId)
                </td>
                <td>
                    <a class="btn btn-sm btn-info"
                       asp-page="./Details"
                       asp-route-id="@item.VitalSignLogId">
                        View
                    </a>

                    <a class="btn btn-sm btn-warning"
                       asp-page="./Edit"
                       asp-route-id="@item.VitalSignLogId">
                        Edit
                    </a>

                    <a class="btn btn-sm btn-danger"
                       asp-page="./Delete"
                       asp-route-id="@item.VitalSignLogId">
                        Delete
                    </a>
                </td>
        </tr>
}
    </tbody>
</table>
