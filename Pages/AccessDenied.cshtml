@page
@model Capstone_Clinic.Pages.AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 640px;">
        <div class="card-body p-4 p-md-5 text-center">
            <div class="display-5 mb-3" aria-hidden="true">403</div>
            <h1 class="h3">Access denied</h1>
            <p class="text-muted">Your staff account does not have permission to open this page. If you believe this is an error, contact the CMS administrator.</p>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Index" class="btn btn-success">Return to dashboard</a>
            }
            else
            {
                <a asp-page="/Login" class="btn btn-success">Go to login</a>
            }
        </div>
    </div>
</div>
