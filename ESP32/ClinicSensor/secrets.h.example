#pragma once

// Copy this file to secrets.h in the same folder and replace the placeholders.
// secrets.h is gitignored. Do not commit the live Wi-Fi password or IoT key.

#define WIFI_SSID "clinic-wifi"
#define WIFI_PASSWORD "wifi-password"

// Public HTTPS origin of the deployed CMS. No path and no trailing slash.
#define CMS_BASE_URL "https://your-live-cms-host"

// Must match IoT:ApiKey configured on the live CMS.
#define IOT_API_KEY "replace-with-live-iot-api-key"

// Optional PEM for the live site certificate authority.
// Leave this empty to encrypt the connection without verifying the certificate.
#define CMS_ROOT_CA ""
